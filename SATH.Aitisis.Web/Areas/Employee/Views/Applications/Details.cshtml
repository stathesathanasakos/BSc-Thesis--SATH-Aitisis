@model SATH.Aitisis.Web.Areas.Employee.ViewModels.Applications.ApplicationReviewDetailsViewModel

@{
    ViewData["Title"] = "Application Review";
}

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h2 class="mb-1">
            Application Review
        </h2>

        <p class="text-muted mb-0">
            Review the submitted application information and supporting documents.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-area="Employee"
           asp-controller="Applications"
           asp-action="Timeline"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            View Timeline
        </a>

        <a asp-area="Employee"
           asp-controller="Applications"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Applications
        </a>
    </div>

</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<!-- Application Summary -->
<div class="card shadow-sm mb-4">

    <div class="card-header bg-light">
        <h5 class="mb-0">
            Application Summary
        </h5>
    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-6">
                <small class="text-muted d-block">
                    Application ID
                </small>

                <span class="fw-semibold">
                    #@Model.Id
                </span>
            </div>

            <div class="col-md-6">
                <small class="text-muted d-block">
                    Application Type
                </small>

                <span class="fw-semibold">
                    @Model.ApplicationTypeName
                </span>
            </div>

            <div class="col-md-6">
                <small class="text-muted d-block">
                    Submitted On
                </small>

                <span>
                    @(Model.SubmissionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                </span>
            </div>

            <div class="col-md-6">

                <small class="text-muted d-block">
                    Status
                </small>

                @if (Model.Status == "Submitted")
                {
                    <span class="badge bg-warning text-dark">
                        Pending
                    </span>
                }
                else if (Model.Status == "Approved")
                {
                    <span class="badge bg-success">
                        Approved
                    </span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge bg-danger">
                        Rejected
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.Status
                    </span>
                }

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <hr />

            <div>
                <small class="text-muted d-block mb-1">
                    Description
                </small>

                <p class="mb-0">
                    @Model.Description
                </p>
            </div>
        }

    </div>

</div>

<!-- Applicant -->
<div class="card shadow-sm mb-4">

    <div class="card-header bg-light">
        <h5 class="mb-0">
            Applicant
        </h5>
    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-6">

                <small class="text-muted d-block">
                    Name
                </small>

                <span class="fw-semibold">
                    @if (string.IsNullOrWhiteSpace(Model.CitizenFirstName) &&
                                        string.IsNullOrWhiteSpace(Model.CitizenLastName))
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        @($"{Model.CitizenFirstName} {Model.CitizenLastName}".Trim())
                    }
                </span>

            </div>

            <div class="col-md-6">

                <small class="text-muted d-block">
                    Email
                </small>

                <span>
                    @if (string.IsNullOrWhiteSpace(Model.CitizenEmail))
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        @Model.CitizenEmail
                    }
                </span>

            </div>

        </div>

    </div>

</div>

<!-- Submitted Information -->
<div class="card shadow-sm mb-4">

    <div class="card-header bg-light">
        <h5 class="mb-0">
            Submitted Information
        </h5>
    </div>

    <div class="card-body">

        @if (!Model.Fields.Any())
        {
            <p class="text-muted mb-0">
                No additional application fields were submitted.
            </p>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Field</th>
                            <th>Submitted Value</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var field in Model.Fields)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @field.Label
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(field.Value))
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                    else
                                    {
                                        @field.Value
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<!-- Supporting Documents -->
<div class="card shadow-sm mb-4">

    <div class="card-header bg-light">
        <h5 class="mb-0">
            Supporting Documents
        </h5>
    </div>

    <div class="card-body">

        @if (!Model.Documents.Any())
        {
            <p class="text-muted mb-0">
                No supporting documents have been uploaded.
            </p>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Document</th>
                            <th>Requirement</th>
                            <th>Uploaded On</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var document in Model.Documents)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @document.OriginalFileName
                                </td>

                                <td>

                                    @document.RequirementName

                                    @if (document.IsRequired)
                                    {
                                        <span class="badge bg-danger ms-1">
                                            Required
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-1">
                                            Optional
                                        </span>
                                    }

                                </td>

                                <td>
                                    @(document.UploadDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td class="text-end">

                                    <a asp-area="Employee"
                                       asp-controller="Applications"
                                       asp-action="ViewDocument"
                                       asp-route-id="@document.DocumentId"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        View PDF
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<!-- Decision -->
<div class="card shadow-sm">

    <div class="card-header bg-light">
        <h5 class="mb-0">
            Decision
        </h5>
    </div>

    <div class="card-body">

        @if (Model.Status == "Submitted")
        {
            <p class="text-muted">
                Review the application information and supporting documents
                before making a final decision.
            </p>

            <div class="row g-3">

                <div class="col-md-6">
                    <form asp-area="Employee"
                          asp-controller="Applications"
                          asp-action="Reject"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="border rounded p-3 h-100">

                        @Html.AntiForgeryToken()

                        <h6 class="text-danger">
                            Reject application
                        </h6>

                        <div class="mb-3">
                            <label for="rejectMessage" class="form-label">
                                Optional message to citizen
                            </label>

                            <textarea id="rejectMessage"
                                  name="employeeMessage"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Example: Missing required income certificate."></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to reject this application?');">
                            Reject
                        </button>

                    </form>
                </div>

                <div class="col-md-6">
                    <form asp-area="Employee"
                          asp-controller="Applications"
                          asp-action="Approve"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="border rounded p-3 h-100">

                        @Html.AntiForgeryToken()

                        <h6 class="text-success">
                            Approve application
                        </h6>

                        <div class="mb-3">
                            <label for="approveMessage" class="form-label">
                                Optional message to citizen
                            </label>

                            <textarea id="approveMessage"
                                  name="employeeMessage"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Example: Your application has been approved."></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-success"
                                onclick="return confirm('Are you sure you want to approve this application?');">
                            Approve
                        </button>

                    </form>
                </div>

            </div>
        }
        else
        {
            <p class="text-muted mb-0">
                This application has already been evaluated.
            </p>
        }

    </div>

</div>