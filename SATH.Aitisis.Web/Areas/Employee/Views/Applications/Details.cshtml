@model SATH.Aitisis.Web.Areas.Employee.ViewModels.Applications.ApplicationReviewDetailsViewModel

@{
    ViewData["Title"] = "Application Review";

    var pageQuery = Context.Request.Query["page"].ToString();

    var currentPage = pageQuery == "2"
        ? 2
        : pageQuery == "3"
            ? 3
            : pageQuery == "4"
                ? 4
                : 1;

    var applicantName = string.IsNullOrWhiteSpace(Model.CitizenFirstName) &&
                        string.IsNullOrWhiteSpace(Model.CitizenLastName)
        ? "—"
        : $"{Model.CitizenFirstName} {Model.CitizenLastName}".Trim();

    var statusText = Model.Status == "Submitted"
        ? "Pending"
        : Model.Status;

    var statusCssClass = Model.Status == "Submitted"
        ? "employee-status-pending"
        : Model.Status == "Approved"
            ? "employee-status-approved"
            : Model.Status == "Rejected"
                ? "employee-status-rejected"
                : "employee-status-neutral";

    string StepClass(int step)
    {
        if (step < currentPage)
        {
            return "completed";
        }

        if (step == currentPage)
        {
            return "current";
        }

        return "upcoming";
    }

    string SegmentClass(int stepBeforeSegment)
    {
        return stepBeforeSegment < currentPage
            ? "completed"
            : "upcoming";
    }

    var hasSubmittedFieldData = Model.Fields.Any() || !string.IsNullOrWhiteSpace(Model.Description);
}

<div class="employee-review-page">

    <div class="employee-review-hero employee-review-hero-with-progress mb-4">

        <div class="employee-review-hero-main">

            <div>
                <span class="employee-list-eyebrow">
                    Review Workspace
                </span>

                <p class="employee-list-subtitle">
                    Review the submitted application information, supporting documents and final decision actions.
                </p>
            </div>

            <div class="employee-review-top-actions">

                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Timeline"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">
                    View Timeline
                </a>

                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Applications
                </a>

            </div>

        </div>

        <div class="employee-review-progress employee-review-progress-inside">

            <div class="employee-review-progress-item @StepClass(1)">
                <div class="employee-review-progress-bullet">
                    1
                </div>

                <div class="employee-review-progress-label">
                    Application
                </div>
            </div>

            <div class="employee-review-progress-segment @SegmentClass(1)">
            </div>

            <div class="employee-review-progress-item @StepClass(2)">
                <div class="employee-review-progress-bullet">
                    2
                </div>

                <div class="employee-review-progress-label">
                    Fields
                </div>
            </div>

            <div class="employee-review-progress-segment @SegmentClass(2)">
            </div>

            <div class="employee-review-progress-item @StepClass(3)">
                <div class="employee-review-progress-bullet">
                    3
                </div>

                <div class="employee-review-progress-label">
                    Documents
                </div>
            </div>

            <div class="employee-review-progress-segment @SegmentClass(3)">
            </div>

            <div class="employee-review-progress-item @StepClass(4)">
                <div class="employee-review-progress-bullet">
                    4
                </div>

                <div class="employee-review-progress-label">
                    Decision
                </div>
            </div>

        </div>

    </div>

    

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (currentPage == 1)
    {
        <div class="row g-4">

            <div class="col-xl-7">

                <div class="card employee-review-card h-100">

                    <div class="employee-review-card-header">

                        <div>
                            <h5 class="mb-1">
                                Application Details
                            </h5>

                            <p class="mb-0">
                                Core information about the submitted citizen application.
                            </p>
                        </div>

                    </div>

                    <div class="card-body p-4">

                        <div class="employee-review-summary-grid">

                            <div class="employee-review-summary-item">
                                <span>Application ID</span>
                                <strong>#@Model.Id</strong>
                            </div>

                            <div class="employee-review-summary-item">
                                <span>Application Type</span>
                                <strong>@Model.ApplicationTypeName</strong>
                            </div>

                            <div class="employee-review-summary-item">
                                <span>Submitted On</span>
                                <strong>@(Model.SubmissionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</strong>
                            </div>

                            <div class="employee-review-summary-item">
                                <span>Status</span>
                                <strong>
                                    <span class="badge employee-status-badge @statusCssClass">
                                        @statusText
                                    </span>
                                </strong>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-5">

                <div class="card employee-review-card h-100">

                    <div class="employee-review-card-header">

                        <div>
                            <h5 class="mb-1">
                                Applicant
                            </h5>

                            <p class="mb-0">
                                Citizen account linked to this application.
                            </p>
                        </div>

                    </div>

                    <div class="card-body p-4">

                        <div class="employee-review-applicant-panel">

                            <div class="employee-review-applicant-avatar">
                                @(applicantName == "—" ? "C" : applicantName.Substring(0, 1).ToUpper())
                            </div>

                            <div>
                                <span>
                                    Applicant Name
                                </span>

                                <strong>
                                    @applicantName
                                </strong>
                            </div>

                        </div>

                        <div class="employee-review-summary-item mt-3">
                            <span>Email</span>

                            <strong>
                                @if (string.IsNullOrWhiteSpace(Model.CitizenEmail))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @Model.CitizenEmail
                                }
                            </strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="employee-review-page-nav">

            <div class="employee-pagination-summary">
                Page 1 of 4 — Application and applicant
            </div>

            <div class="employee-pagination-actions">
                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   asp-route-page="2"
                   class="btn btn-primary">
                    Go to Fields
                </a>
            </div>

        </div>
    }
    else if (currentPage == 2)
    {
        <div class="card employee-review-card">

            <div class="employee-review-card-header">

                <div>
                    <h5 class="mb-1">
                        Submitted Fields
                    </h5>

                    <p class="mb-0">
                        Citizen-provided values for this application type. The description is included as part of the review data.
                    </p>
                </div>

                <span class="employee-table-chip">
                    @(Model.Fields.Count + (!string.IsNullOrWhiteSpace(Model.Description) ? 1 : 0)) item(s)
                </span>

            </div>

            <div class="card-body p-4">

                @if (!hasSubmittedFieldData)
                {
                    <div class="employee-inline-empty">
                        No submitted field data is available.
                    </div>
                }
                else
                {
                    <div class="employee-review-field-grid employee-review-field-grid-three">

                        <div class="employee-review-field-item employee-review-field-item-highlight">
                            <span>
                                Application Type
                            </span>

                            <strong>
                                @Model.ApplicationTypeName
                            </strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div class="employee-review-field-item employee-review-field-item-description">
                                <span>
                                    Citizen Description
                                </span>

                                <strong>
                                    @Model.Description
                                </strong>
                            </div>
                        }

                        @foreach (var field in Model.Fields)
                        {
                            <div class="employee-review-field-item">

                                <span>
                                    @field.Label
                                </span>

                                <strong>
                                    @if (string.IsNullOrWhiteSpace(field.Value))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        @field.Value
                                    }
                                </strong>

                            </div>
                        }

                    </div>
                }

                <div class="employee-ai-panel mt-4">

                    <div>
                        <span class="employee-list-eyebrow">
                            AI Review Assistant
                        </span>

                        <p class="mb-0">
                            The assistant uses the application type and submitted fields. Uploaded PDF files are not sent to the AI provider.
                        </p>
                    </div>

                    <form asp-area="Employee"
                          asp-controller="Applications"
                          asp-action="GenerateAiReviewSummary"
                          asp-route-id="@Model.Id"
                          asp-route-page="2"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-primary">
                            Generate AI Review Summary
                        </button>

                    </form>

                </div>

            </div>

        </div>

        <div class="employee-review-page-nav">

            <div class="employee-pagination-summary">
                Page 2 of 4 — Submitted fields and AI assistance
            </div>

            <div class="employee-pagination-actions">

                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   asp-route-page="1"
                   class="btn btn-outline-primary">
                    Previous
                </a>

                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   asp-route-page="3"
                   class="btn btn-primary">
                    Go to Documents
                </a>

            </div>

        </div>
    }
    else if (currentPage == 3)
    {
        <div class="card employee-review-card">

            <div class="employee-review-card-header">

                <div>
                    <h5 class="mb-1">
                        Uploaded Documents
                    </h5>

                    <p class="mb-0">
                        Supporting PDF files uploaded by the citizen for this application.
                    </p>
                </div>

                <span class="employee-table-chip">
                    @Model.Documents.Count document(s)
                </span>

            </div>

            <div class="card-body p-4">

                @if (!Model.Documents.Any())
                {
                    <div class="employee-inline-empty">
                        No supporting documents have been uploaded.
                    </div>
                }
                else
                {
                    <div class="employee-review-document-list employee-review-document-list-wide">

                        @foreach (var document in Model.Documents)
                        {
                            <div class="employee-review-document-item employee-review-document-item-wide">

                                <div class="employee-review-document-icon">
                                    PDF
                                </div>

                                <div class="employee-review-document-content">

                                    <div class="employee-review-document-name">
                                        @document.OriginalFileName
                                    </div>

                                    <div class="employee-review-document-meta">
                                        Requirement: @document.RequirementName

                                        @if (document.IsRequired)
                                        {
                                            <span class="badge employee-status-badge employee-status-rejected ms-1">
                                                Required
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge employee-status-badge employee-status-neutral ms-1">
                                                Optional
                                            </span>
                                        }
                                    </div>

                                    <div class="employee-review-document-date">
                                        Uploaded on @(document.UploadDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                    </div>

                                </div>

                                <div class="employee-review-document-action">
                                    <a asp-area="Employee"
                                       asp-controller="Applications"
                                       asp-action="ViewDocument"
                                       asp-route-id="@document.DocumentId"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        View PDF
                                    </a>
                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

        <div class="employee-review-page-nav">

            <div class="employee-pagination-summary">
                Page 3 of 4 — Uploaded documents
            </div>

            <div class="employee-pagination-actions">

                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   asp-route-page="2"
                   class="btn btn-outline-primary">
                    Previous
                </a>

                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   asp-route-page="4"
                   class="btn btn-primary">
                    Go to Decision
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card employee-review-card employee-decision-card">

            <div class="card-body p-4">

                @if (Model.Status == "Submitted")
                {

                    <div class="row g-4">

                        <div class="col-xl-6">

                            <form asp-area="Employee"
                                  asp-controller="Applications"
                                  asp-action="Reject"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="employee-decision-form employee-decision-form-reject h-100">

                                @Html.AntiForgeryToken()

                                <div class="employee-decision-form-header">
                                    <div class="employee-decision-icon employee-decision-icon-reject">
                                        !
                                    </div>

                                    <div>
                                        <h4>
                                            Reject Application
                                        </h4>

                                        <p>
                                            Send the application back as rejected with an optional message to the citizen.
                                        </p>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="rejectMessage"
                                           class="form-label">
                                        Optional message to citizen
                                    </label>

                                    <textarea id="rejectMessage"
                                      name="employeeMessage"
                                      class="form-control employee-review-control"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Example: Missing required income certificate."></textarea>
                                </div>

                                <button type="submit"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to reject this application?');">
                                    Reject Application
                                </button>

                            </form>

                        </div>

                        <div class="col-xl-6">

                            <form asp-area="Employee"
                                  asp-controller="Applications"
                                  asp-action="Approve"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="employee-decision-form employee-decision-form-approve h-100">

                                @Html.AntiForgeryToken()

                                <div class="employee-decision-form-header">
                                    <div class="employee-decision-icon employee-decision-icon-approve">
                                        ✓
                                    </div>

                                    <div>
                                        <h4>
                                            Approve Application
                                        </h4>

                                        <p>
                                            Approve the application and allow the system to complete the official decision.
                                        </p>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="approveMessage"
                                           class="form-label">
                                        Optional message to citizen
                                    </label>

                                    <textarea id="approveMessage"
                                      name="employeeMessage"
                                      class="form-control employee-review-control"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Example: Your application has been approved."></textarea>
                                </div>

                                <button type="submit"
                                        class="btn btn-success"
                                        onclick="return confirm('Are you sure you want to approve this application?');">
                                    Approve Application
                                </button>

                            </form>

                        </div>

                    </div>
                }
                else
                {
                    <div class="employee-inline-empty">
                        This application has already been evaluated.
                    </div>
                }

            </div>

        </div>

        <div class="employee-review-page-nav">

            <div class="employee-pagination-summary">
                Page 4 of 4 — Final decision
            </div>

            <div class="employee-pagination-actions">

                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   asp-route-page="3"
                   class="btn btn-outline-primary">
                    Previous
                </a>

            </div>

        </div>
    }

</div>

@if (Model.AiReviewSummary != null)
{
    <div class="modal fade"
         id="aiReviewModal"
         tabindex="-1"
         aria-labelledby="aiReviewModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content employee-ai-modal">

                <div class="modal-header">
                    <div>
                        <span class="employee-list-eyebrow">
                            AI Review Assistant
                        </span>

                        <h5 class="modal-title"
                            id="aiReviewModalLabel">
                            AI Review Summary
                        </h5>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="alert alert-warning">
                        @Model.AiReviewSummary.Disclaimer
                    </div>

                    <h6>
                        Summary
                    </h6>

                    <p>
                        @Model.AiReviewSummary.Summary
                    </p>

                    <hr />

                    <h6>
                        Key Information
                    </h6>

                    @if (Model.AiReviewSummary.KeyInformation.Any())
                    {
                        <ul>
                            @foreach (var item in Model.AiReviewSummary.KeyInformation)
                            {
                                <li>
                                    @item
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">
                            No key information was returned.
                        </p>
                    }

                    <hr />

                    <h6>
                        PDF Review Focus
                    </h6>

                    @if (Model.AiReviewSummary.PdfReviewFocus.Any())
                    {
                        <ul>
                            @foreach (var item in Model.AiReviewSummary.PdfReviewFocus)
                            {
                                <li>
                                    @item
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">
                            No PDF review focus points were returned.
                        </p>
                    }

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script>
        window.addEventListener('load', function () {
            const modalElement = document.getElementById('aiReviewModal');

            if (modalElement) {
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            }
        });
    </script>
}