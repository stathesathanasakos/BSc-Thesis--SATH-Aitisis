@model SATH.Aitisis.Web.ViewModels.Applications.ApplicationTimelineViewModel
@using SATH.Aitisis.Domain.Enums

@{
    ViewData["Title"] = "Application Timeline";

    var statusText = Model.Status == ApplicationStatus.Submitted
        ? "Pending"
        : Model.Status.ToString();

    var statusCssClass = Model.Status == ApplicationStatus.Submitted
        ? "employee-status-pending"
        : Model.Status == ApplicationStatus.Approved
            ? "employee-status-approved"
            : Model.Status == ApplicationStatus.Rejected
                ? "employee-status-rejected"
                : "employee-status-neutral";
}

<div class="employee-timeline-page">

    <div class="card employee-timeline-summary-card mb-4">

        <div class="card-body p-4">

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="employee-summary-item">
                        <span>
                            Application ID
                        </span>

                        <strong>
                            #@Model.ApplicationId
                        </strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="employee-summary-item">
                        <span>
                            Application Type
                        </span>

                        <strong>
                            @Model.ApplicationTypeName
                        </strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="employee-summary-item">
                        <span>
                            Current Status
                        </span>

                        <strong>
                            <span class="badge employee-status-badge @statusCssClass">
                                @statusText
                            </span>
                        </strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ProtocolNumber))
                {
                    <div class="col-12">
                        <div class="employee-protocol-panel">
                            <span>
                                Protocol Number
                            </span>

                            <strong>
                                @Model.ProtocolNumber
                            </strong>
                        </div>
                    </div>
                }

            </div>

        </div>

    </div>

    <div class="card employee-timeline-card">

        <div class="employee-timeline-card-header">

            <div>
                <h5 class="mb-1">
                    Timeline Events
                </h5>

                <p class="mb-0">
                    Chronological activity for this application.
                </p>
            </div>

            <div>
                <a asp-area="Employee"
                   asp-controller="Applications"
                   asp-action="Details"
                   asp-route-id="@Model.ApplicationId"
                   class="btn btn-primary employee-list-main-action">
                    Back to Review
                </a>
            </div>

        </div>

        <div class="card-body p-4">

            @if (!Model.Items.Any())
            {
                <div class="employee-inline-empty">
                    No timeline events are available.
                </div>
            }
            else
            {
                <div class="employee-timeline-list">

                    @foreach (var item in Model.Items)
                    {
                        <div class="employee-timeline-item">

                            <div class="employee-timeline-marker employee-timeline-marker-@item.CssClass">
                            </div>

                            <div class="employee-timeline-content">

                                <div class="employee-timeline-content-header">
                                    <h6>
                                        @item.Title
                                    </h6>

                                    <span>
                                        @item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                                <p>
                                    @item.Description
                                </p>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>