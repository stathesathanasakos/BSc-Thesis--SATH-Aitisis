@model SATH.Aitisis.Web.ViewModels.Applications.ApplicationTimelineViewModel

@{
    ViewData["Title"] = "Application Timeline";
}

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h2 class="mb-1">
            Application Timeline
        </h2>

        <p class="text-muted mb-0">
            Review the lifecycle of this submitted application.
        </p>
    </div>

    <a asp-area="Employee"
       asp-controller="Applications"
       asp-action="Details"
       asp-route-id="@Model.ApplicationId"
       class="btn btn-outline-secondary">
        Back to Review
    </a>

</div>

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-4">
                <small class="text-muted d-block">
                    Application ID
                </small>

                <span class="fw-semibold">
                    #@Model.ApplicationId
                </span>
            </div>

            <div class="col-md-4">
                <small class="text-muted d-block">
                    Application Type
                </small>

                <span class="fw-semibold">
                    @Model.ApplicationTypeName
                </span>
            </div>

            <div class="col-md-4">
                <small class="text-muted d-block">
                    Current Status
                </small>

                @if (Model.Status == SATH.Aitisis.Domain.Enums.ApplicationStatus.Submitted)
                {
                    <span class="badge bg-warning text-dark">
                        Pending
                    </span>
                }
                else if (Model.Status == SATH.Aitisis.Domain.Enums.ApplicationStatus.Approved)
                {
                    <span class="badge bg-success">
                        Approved
                    </span>
                }
                else if (Model.Status == SATH.Aitisis.Domain.Enums.ApplicationStatus.Rejected)
                {
                    <span class="badge bg-danger">
                        Rejected
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.Status
                    </span>
                }
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ProtocolNumber))
        {
            <hr />

            <div>
                <small class="text-muted d-block">
                    Protocol Number
                </small>

                <span class="fw-semibold">
                    @Model.ProtocolNumber
                </span>
            </div>
        }

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-header bg-light">
        <h5 class="mb-0">
            Timeline
        </h5>
    </div>

    <div class="card-body">

        @if (!Model.Items.Any())
        {
            <p class="text-muted mb-0">
                No timeline events are available.
            </p>
        }
        else
        {
            <div class="list-group list-group-flush">

                @foreach (var item in Model.Items)
                {
                    <div class="list-group-item px-0">

                        <div class="d-flex justify-content-between align-items-start gap-3">

                            <div>
                                <h6 class="mb-1">
                                    <span class="badge bg-@item.CssClass me-2">
                                        &nbsp;
                                    </span>

                                    @item.Title
                                </h6>

                                <p class="text-muted mb-1">
                                    @item.Description
                                </p>
                            </div>

                            <small class="text-muted text-nowrap">
                                @(item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                            </small>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>