@model IReadOnlyCollection<SATH.Aitisis.Web.Areas.Employee.ViewModels.Applications.PendingApplicationListItemViewModel>

@{
    ViewData["Title"] = "Pending Applications";
}

<div class="mb-4">
    <h2 class="mb-1">Pending Applications</h2>

    <p class="text-muted mb-0">
        Review applications submitted by citizens that are waiting for evaluation.
    </p>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">

            <h5 class="mb-2">
                No pending applications
            </h5>

            <p class="text-muted mb-0">
                There are currently no applications waiting for review.
            </p>

        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Application ID</th>
                            <th>Application Type</th>
                            <th>Submitted On</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var application in Model)
                        {
                            <tr>
                                <td>
                                    #@application.Id
                                </td>

                                <td class="fw-semibold">
                                    @application.ApplicationTypeName
                                </td>

                                <td>
                                    @application.SubmissionDate
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @application.StatusText
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-area="Employee"
                                       asp-controller="Applications"
                                       asp-action="Details"
                                       asp-route-id="@application.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}