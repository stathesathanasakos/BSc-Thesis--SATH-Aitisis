@model SATH.Aitisis.Web.Areas.Employee.ViewModels.Dashboard.EmployeeDashboardViewModel

@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="mb-4">
    <h2 class="mb-1">
        Employee Dashboard
    </h2>

    <p class="text-muted mb-0">
        Review submitted citizen applications, inspect supporting documents
        and make approval or rejection decisions.
    </p>
</div>

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-warning">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Pending Applications
                </p>

                <h2 class="mb-0">
                    @Model.PendingApplications
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-success">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Approved by Me
                </p>

                <h2 class="mb-0">
                    @Model.ApprovedByMe
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-danger">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Rejected by Me
                </p>

                <h2 class="mb-0">
                    @Model.RejectedByMe
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Total Decisions
                </p>

                <h2 class="mb-0">
                    @Model.TotalDecisionsByMe
                </h2>
            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <!-- Pending Applications -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">

            <div class="card-body d-flex flex-column">

                <h4 class="card-title">
                    Pending Applications
                </h4>

                <p class="card-text text-muted">
                    View applications submitted by citizens that are waiting
                    for employee review.
                </p>

                <div class="mt-auto">
                    <a asp-area="Employee"
                       asp-controller="Applications"
                       asp-action="Index"
                       class="btn btn-primary">
                        Review Applications
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Review Workflow -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">

            <div class="card-body">

                <h4 class="card-title">
                    Review Workflow
                </h4>

                <p class="card-text text-muted">
                    Each application review includes submitted form values,
                    uploaded PDF documents and final decision actions.
                </p>

                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <span class="badge bg-light text-dark border me-2">
                            1
                        </span>
                        Inspect application details
                    </li>

                    <li class="mb-2">
                        <span class="badge bg-light text-dark border me-2">
                            2
                        </span>
                        Open supporting PDF documents
                    </li>

                    <li>
                        <span class="badge bg-light text-dark border me-2">
                            3
                        </span>
                        Approve or reject the application
                    </li>
                </ul>

            </div>
        </div>
    </div>

</div>

<div class="alert alert-light border mt-4">
    Approved applications receive a protocol number, while rejected applications
    are marked as completed without a protocol number.
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        @await Component.InvokeAsync("DashboardCalendar")
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">

            <div class="card-header bg-light">
                <h5 class="mb-0">
                    Employee Review Guide
                </h5>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    Use the dashboard to monitor pending applications and your
                    completed decisions.
                </p>

                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <span class="badge bg-light text-dark border me-2">
                            1
                        </span>
                        Review pending citizen applications.
                    </li>

                    <li class="mb-2">
                        <span class="badge bg-light text-dark border me-2">
                            2
                        </span>
                        Inspect submitted form data and PDF documents.
                    </li>

                    <li>
                        <span class="badge bg-light text-dark border me-2">
                            3
                        </span>
                        Approve or reject applications according to the process.
                    </li>
                </ul>
            </div>

        </div>
    </div>
</div>