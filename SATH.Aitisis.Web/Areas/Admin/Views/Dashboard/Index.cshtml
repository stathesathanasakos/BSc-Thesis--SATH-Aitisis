@model SATH.Aitisis.Web.Areas.Admin.ViewModels.Dashboard.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-4">
    <h2 class="mb-1">
        Admin Dashboard
    </h2>

    <p class="text-muted mb-0">
        Manage employees, configure application types and monitor the overall
        application activity of the system.
    </p>
</div>

<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Total Applications
                </p>

                <h2 class="mb-0">
                    @Model.TotalApplications
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-warning">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Pending Applications
                </p>

                <h2 class="mb-0">
                    @Model.PendingApplications
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-success">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Approved Applications
                </p>

                <h2 class="mb-0">
                    @Model.ApprovedApplications
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-danger">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Rejected Applications
                </p>

                <h2 class="mb-0">
                    @Model.RejectedApplications
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Active Application Types
                </p>

                <h2 class="mb-0">
                    @Model.ActiveApplicationTypes
                </h2>
            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <!-- Employee Management -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">

            <div class="card-body d-flex flex-column">

                <h4 class="card-title">
                    Employee Management
                </h4>

                <p class="card-text text-muted">
                    Create employee accounts and manage existing employees.
                    Employees can review submitted applications and make
                    approval or rejection decisions.
                </p>

                <div class="mt-auto">
                    <a asp-area="Admin"
                       asp-controller="Employees"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Employees
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Application Type Management -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">

            <div class="card-body d-flex flex-column">

                <h4 class="card-title">
                    Application Types
                </h4>

                <p class="card-text text-muted">
                    Configure the application types, dynamic fields,
                    document requirements and payment requirements
                    available to citizens.
                </p>

                <div class="mt-auto">
                    <a asp-area="Admin"
                       asp-controller="ApplicationTypes"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Application Types
                    </a>
                </div>

            </div>
        </div>
    </div>

</div>

<div class="alert alert-light border mt-4">
    Changes to application types determine the information and supporting
    documents requested from citizens during application submission.
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        @await Component.InvokeAsync("DashboardCalendar")
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">

            <div class="card-header bg-light">
                <h5 class="mb-0">
                    Administration Notes
                </h5>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    Use the dashboard statistics to monitor the current state
                    of submitted applications and the available application
                    types configured for citizens.
                </p>

                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <span class="badge bg-light text-dark border me-2">
                            1
                        </span>
                        Review overall application activity.
                    </li>

                    <li class="mb-2">
                        <span class="badge bg-light text-dark border me-2">
                            2
                        </span>
                        Manage employee access.
                    </li>

                    <li>
                        <span class="badge bg-light text-dark border me-2">
                            3
                        </span>
                        Configure active application types.
                    </li>
                </ul>
            </div>

        </div>
    </div>
</div>