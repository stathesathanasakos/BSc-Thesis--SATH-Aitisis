@model SATH.Aitisis.Web.Areas.Admin.ViewModels.Employees.CreateEmployeeViewModel

@{
    ViewData["Title"] = "Create Employee";
}

<div class="admin-form-page">

    <div class="admin-list-hero mb-4">

        <div>
            <span class="admin-list-eyebrow">
                Administration – Employee Management
            </span>

            <p class="admin-list-subtitle">
                Create a new employee account. The account will be assigned the Employee role automatically.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary admin-list-main-action">
            Back to Employees
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-9">

            <div class="card admin-form-card">

                <div class="admin-form-card-header">

                    <div class="admin-form-icon">
                        E
                    </div>

                    <div>
                        <h5 class="mb-1">
                            Employee Account Details
                        </h5>

                        <p class="mb-0">
                            Fill in the employee identity and sign-in credentials.
                        </p>
                    </div>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="FirstName"
                                       class="form-label">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control admin-form-control"
                                       placeholder="e.g. Lydia" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName"
                                       class="form-label">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control admin-form-control"
                                       placeholder="e.g. Makro" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email"
                                       class="form-label">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control admin-form-control"
                                       placeholder="employee@example.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password"
                                       class="form-label">
                                    Password
                                </label>

                                <input asp-for="Password"
                                       class="form-control admin-form-control"
                                       placeholder="Enter password" />

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword"
                                       class="form-label">
                                    Confirm Password
                                </label>

                                <input asp-for="ConfirmPassword"
                                       class="form-control admin-form-control"
                                       placeholder="Repeat password" />

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="admin-form-actions mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Create Employee
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}