@model IReadOnlyCollection<SATH.Aitisis.Web.Areas.Admin.ViewModels.Employees.EmployeeListViewModel>

@{
    ViewData["Title"] = "Employee Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Employee Management</h2>
        <p class="text-muted mb-0">Create and manage employee accounts for the system.</p>
    </div>

    <div>
        <a asp-action="Create" class="btn btn-primary">Create Employee</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">No employees</h5>
            <p class="card-text text-muted">There are currently no employee accounts in the system.</p>
            <a asp-action="Create" class="btn btn-primary">Create Employee</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td class="align-middle">@employee.FirstName @employee.LastName</td>
                                <td class="align-middle">@employee.Email</td>
                                <td class="align-middle">
                                    @if (employee.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="align-middle">@employee.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="align-middle">
                                    @if (employee.IsActive)
                                    {
                                        <form asp-action="Deactivate" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@employee.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivate" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@employee.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
