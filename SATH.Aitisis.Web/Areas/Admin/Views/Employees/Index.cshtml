@model IReadOnlyCollection<SATH.Aitisis.Web.Areas.Admin.ViewModels.Employees.EmployeeListViewModel>

@{
    ViewData["Title"] = "Employee Management";

    const int pageSize = 4;
    var pageQuery = Context.Request.Query["page"].ToString();

    var currentPage = int.TryParse(pageQuery, out var parsedPage) && parsedPage > 0
        ? parsedPage
        : 1;

    var totalItems = Model.Count;
    var totalPages = totalItems == 0
        ? 1
        : (int)Math.Ceiling((double)totalItems / pageSize);

    if (currentPage > totalPages)
    {
        currentPage = totalPages;
    }

    var employees = Model
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    var firstItemNumber = totalItems == 0
        ? 0
        : ((currentPage - 1) * pageSize) + 1;

    var lastItemNumber = Math.Min(currentPage * pageSize, totalItems);
}

<div class="admin-list-page">

    <div class="admin-list-hero mb-4">

        <div>
            <span class="admin-list-eyebrow">
                Administration – Employee Management
            </span>

            <p class="admin-list-subtitle">
                Create, monitor and manage employee accounts that can review submitted citizen applications.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary admin-list-main-action">
            Create Employee
        </a>

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card admin-empty-card">
            <div class="card-body text-center py-5">

                <div class="admin-empty-icon">
                    E
                </div>

                <h5 class="mt-3 mb-2">
                    No employees yet
                </h5>

                <p class="text-muted mb-4">
                    There are currently no employee accounts in the system.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Create Employee
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card admin-table-card">

            <div class="card-body p-0">

                <div class="admin-table-toolbar">

                    <div>
                        <h5 class="mb-1">
                            Employees
                        </h5>

                        <p class="text-muted mb-0">
                            Showing @firstItemNumber-@lastItemNumber of @totalItems employee accounts.
                        </p>
                    </div>

                    <span class="admin-table-chip">
                        Page @currentPage of @totalPages
                    </span>

                </div>

                <div class="table-responsive">

                    <table class="table admin-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var employee in employees)
                            {
                                <tr>
                                    <td>
                                        <div class="admin-entity-cell">
                                            <div class="admin-entity-avatar">
                                                @((!string.IsNullOrWhiteSpace(employee.FirstName)
                                                                                        ? employee.FirstName.Substring(0, 1)
                                                                                        : "E"))
                                    </div>

                                            <div>
                                                <div class="admin-entity-title">
                                                    @employee.FirstName @employee.LastName
                                                </div>

                                                <div class="admin-entity-subtitle">
                                                    Employee account
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="admin-muted-text">
                                            @employee.Email
                                        </span>
                                    </td>

                                    <td>
                                @if (employee.IsActive)
                                        {
                                            <span class="badge admin-status-badge admin-status-active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge admin-status-badge admin-status-inactive">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="admin-muted-text">
                                            @employee.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        @if (employee.IsActive)
                                        {
                                            <form asp-action="Deactivate"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@employee.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Deactivate
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Reactivate"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@employee.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Reactivate
                                                </button>

                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <div class="admin-pagination-bar">

                    <div class="admin-pagination-summary">
                        Showing @firstItemNumber-@lastItemNumber of @totalItems
                    </div>

                    <div class="admin-pagination-actions">

                        @if (currentPage > 1)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               class="btn btn-outline-primary">
                                Previous
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled>
                                Previous
                            </button>
                        }

                        @if (currentPage < totalPages)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               class="btn btn-primary">
                                Next
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled>
                                Next
                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</div>