@model IReadOnlyCollection<SATH.Aitisis.Web.Areas.Admin.ViewModels.ApplicationTypes.ApplicationTypeListViewModel>

@{
    ViewData["Title"] = "Application Types";

    const int pageSize = 2;

    var pageQuery = Context.Request.Query["page"].ToString();

    var currentPage = int.TryParse(pageQuery, out var parsedPage) && parsedPage > 0
        ? parsedPage
        : 1;

    var totalItems = Model.Count;
    var totalPages = totalItems == 0
        ? 1
        : (int)Math.Ceiling((double)totalItems / pageSize);

    if (currentPage > totalPages)
    {
        currentPage = totalPages;
    }

    var applicationTypes = Model
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    var firstItemNumber = totalItems == 0
        ? 0
        : ((currentPage - 1) * pageSize) + 1;

    var lastItemNumber = Math.Min(currentPage * pageSize, totalItems);
}

<div class="admin-list-page">

    <div class="admin-list-hero mb-4">

        <div>
            <span class="admin-list-eyebrow">
                Administration - Application Type Management
            </span>

            <p class="admin-list-subtitle">
                Configure the citizen services, dynamic fields, document requirements and payment rules available in the portal.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary admin-list-main-action">
            Create Application Type
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card admin-empty-card">
            <div class="card-body text-center py-5">

                <div class="admin-empty-icon">
                    A
                </div>

                <h5 class="mt-3 mb-2">
                    No application types yet
                </h5>

                <p class="text-muted mb-4">
                    No application types have been created yet.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Create Application Type
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card admin-table-card">

            <div class="card-body p-0">

                <div class="admin-table-toolbar">

                    <div>
                        <h5 class="mb-1">
                            Available application types
                        </h5>

                        <p class="text-muted mb-0">
                            Showing @firstItemNumber-@lastItemNumber of @totalItems configured application types.
                        </p>
                    </div>

                    <span class="admin-table-chip">
                        Page @currentPage of @totalPages
                    </span>

                </div>

                <div class="table-responsive">

                    <table class="table admin-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Payment</th>
                                <th>Fee</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var applicationType in applicationTypes)
                            {
                                <tr>
                                    <td>
                                        <div class="admin-entity-cell">
                                            <div class="admin-entity-avatar admin-entity-avatar-orange">
                                                @((!string.IsNullOrWhiteSpace(applicationType.Name)
                                                                                        ? applicationType.Name.Substring(0, 1)
                                                                                        : "A"))
                                    </div>

                                            <div>
                                                <div class="admin-entity-title">
                                                    @applicationType.Name
                                                </div>

                                                <div class="admin-entity-subtitle">
                                                    Citizen service
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                @if (string.IsNullOrWhiteSpace(applicationType.Description))
                                        {
                                            <span class="admin-muted-text">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-description-text">
                                                @applicationType.Description
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (applicationType.RequiresPayment)
                                        {
                                            <span class="badge admin-status-badge admin-status-payment">
                                                Required
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge admin-status-badge admin-status-inactive">
                                                Not Required
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (applicationType.RequiresPayment &&
                                                                        applicationType.FeeAmount.HasValue)
                                        {
                                            <span class="admin-money-text">
                                                @applicationType.FeeAmount.Value.ToString("0.00") €
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-muted-text">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (applicationType.IsActive)
                                        {
                                            <span class="badge admin-status-badge admin-status-active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge admin-status-badge admin-status-inactive">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="admin-muted-text">
                                            @applicationType.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">

                                            <a asp-action="Details"
                                               asp-route-id="@applicationType.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Configure
                                            </a>

                                            @if (applicationType.IsActive)
                                            {
                                                <form asp-action="Deactivate"
                                                      asp-route-id="@applicationType.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Are you sure you want to deactivate this application type? Citizens will no longer be able to start new applications of this type.');">
                                                        Deactivate
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Reactivate"
                                                      asp-route-id="@applicationType.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            onclick="return confirm('Are you sure you want to reactivate this application type? Citizens will be able to start new applications of this type.');">
                                                        Reactivate
                                                    </button>

                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <div class="admin-pagination-bar">

                    <div class="admin-pagination-summary">
                        Showing @firstItemNumber-@lastItemNumber of @totalItems
                    </div>

                    <div class="admin-pagination-actions">

                        @if (currentPage > 1)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               class="btn btn-outline-primary">
                                Previous
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled>
                                Previous
                            </button>
                        }

                        @if (currentPage < totalPages)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               class="btn btn-primary">
                                Next
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled>
                                Next
                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</div>