@model SATH.Aitisis.Web.Areas.Admin.ViewModels.ApplicationTypes.ApplicationTypeDetailsViewModel
@using SATH.Aitisis.Domain.Enums

@{
    ViewData["Title"] = "Configure Application Type";

    var pageQuery = Context.Request.Query["page"].ToString();

    var currentPage = pageQuery == "2"
        ? 2
        : 1;
}

<div class="admin-config-page">

    <div class="admin-list-hero mb-4">

        <div>
            <span class="admin-list-eyebrow">
                Administration – Application Type Configuration
            </span>

            <p class="admin-list-subtitle">
                Configure dynamic form fields and required PDF documents for this citizen service.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center admin-list-main-action">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Application Types
            </a>

            @if (currentPage == 1)
            {
                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   asp-route-page="2"
                   class="btn btn-primary">
                    Add new Documents
                </a>
            }
            else
            {
                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   asp-route-page="1"
                   class="btn btn-outline-primary">
                    Add new Fields
                </a>
            }

        </div>

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (currentPage == 1)
    {
        <div class="card admin-config-card">

            <div class="admin-config-card-header">

                <div>
                    <h4 class="mb-1">
                        Form Fields
                    </h4>

                    <p class="mb-0">
                        Define the information citizens must provide when submitting this application.
                    </p>
                </div>

                <span class="admin-table-chip">
                    @Model.Fields.Count total
                </span>

            </div>

            <div class="card-body p-0">

                @if (Model.Fields.Count == 0)
                {
                    <div class="admin-inline-empty">
                        No form fields have been configured yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table admin-table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Label</th>
                                    <th>Technical Name</th>
                                    <th>Type</th>
                                    <th>Required</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var field in Model.Fields.OrderBy(x => x.DisplayOrder))
                                {
                                    <tr>
                                        <td>
                                            <div class="admin-entity-title">
                                                @field.Label
                                            </div>
                                        </td>

                                        <td>
                                            <code class="admin-code-pill">
                                                @field.Name
                                            </code>
                                        </td>

                                        <td>
                                            <span class="admin-muted-text">
                                                @field.FieldType
                                            </span>
                                        </td>

                                        <td>
                                            @if (field.IsRequired)
                                            {
                                                <span class="badge admin-status-badge admin-status-active">
                                                    Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge admin-status-badge admin-status-inactive">
                                                    Optional
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }

            </div>

            <div class="admin-config-form-panel">

                <h5 class="mb-3">
                    Add Field
                </h5>

                <form asp-action="AddField"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="ApplicationTypeId"
                           value="@Model.Id" />

                    <div class="row g-3">

                        <div class="col-md-3">
                            <label class="form-label">
                                Technical Name
                            </label>

                            <input name="Name"
                                   class="form-control admin-form-control"
                                   placeholder="AnnualIncome"
                                   required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">
                                Label
                            </label>

                            <input name="Label"
                                   class="form-control admin-form-control"
                                   placeholder="Annual Income"
                                   required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">
                                Field Type
                            </label>

                            <select name="FieldType"
                                    class="form-select admin-form-control"
                                    asp-items="Html.GetEnumSelectList<ApplicationFieldType>()">
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check admin-form-check mb-2">
                                <input name="IsRequired"
                                       value="true"
                                       class="form-check-input"
                                       type="checkbox"
                                       id="fieldRequired" />

                                <label class="form-check-label"
                                       for="fieldRequired">
                                    Required field
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="admin-config-actions mt-3">

                        <button type="submit"
                                class="btn btn-primary">
                            Add Field
                        </button>

                    </div>

                </form>

            </div>

        </div>
    }
    else
    {
        <div class="card admin-config-card">

            <div class="admin-config-card-header">

                <div>
                    <h4 class="mb-1">
                        Document Requirements
                    </h4>

                    <p class="mb-0">
                        Define the supporting PDF documents citizens must upload.
                    </p>
                </div>

                <span class="admin-table-chip">
                    @Model.DocumentRequirements.Count total
                </span>

            </div>

            <div class="card-body p-0">

                @if (Model.DocumentRequirements.Count == 0)
                {
                    <div class="admin-inline-empty">
                        No document requirements have been configured yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table admin-table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Description</th>
                                    <th>Required</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var requirement in Model.DocumentRequirements.OrderBy(x => x.DisplayOrder))
                                {
                                    <tr>
                                        <td>
                                            <div class="admin-entity-title">
                                                @requirement.Name
                                            </div>
                                        </td>

                                        <td>
                                            @if (string.IsNullOrWhiteSpace(requirement.Description))
                                            {
                                                <span class="admin-muted-text">
                                                    —
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="admin-description-text">
                                                    @requirement.Description
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (requirement.IsRequired)
                                            {
                                                <span class="badge admin-status-badge admin-status-active">
                                                    Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge admin-status-badge admin-status-inactive">
                                                    Optional
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }

            </div>

            <div class="admin-config-form-panel">

                <h5 class="mb-3">
                    Add Document Requirement
                </h5>

                <form asp-action="AddDocumentRequirement"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="ApplicationTypeId"
                           value="@Model.Id" />

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label">
                                Document Name
                            </label>

                            <input name="Name"
                                   class="form-control admin-form-control"
                                   placeholder="Tax Statement"
                                   required />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">
                                Description
                            </label>

                            <input name="Description"
                                   class="form-control admin-form-control"
                                   placeholder="Latest annual tax statement" />
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check admin-form-check mb-2">
                                <input name="IsRequired"
                                       value="true"
                                       class="form-check-input"
                                       type="checkbox"
                                       id="documentRequired" />

                                <label class="form-check-label"
                                       for="documentRequired">
                                    Required document
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="admin-config-actions mt-3">

                        <button type="submit"
                                class="btn btn-primary">
                            Add Document Requirement
                        </button>

                    </div>

                </form>

            </div>

        </div>
    }

</div>