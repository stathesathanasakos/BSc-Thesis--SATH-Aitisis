@model SATH.Aitisis.Web.Areas.Admin.ViewModels.ApplicationTypes.CreateApplicationTypeViewModel

@{
    ViewData["Title"] = "Create Application Type";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Create Application Type</h2>

        <p class="text-muted mb-0">
            Create a new application type that will later be available to citizens.
        </p>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-secondary">
            Back to Application Types
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RequiresPayment"
                               class="form-check-input" />

                        <label asp-for="RequiresPayment"
                               class="form-check-label">
                        </label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FeeAmount"
                               class="form-label">
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">€</span>

                            <input asp-for="FeeAmount"
                                   class="form-control"
                                   step="0.01" />
                        </div>

                        <span asp-validation-for="FeeAmount"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Required only when payment is enabled.
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Create Application Type
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}