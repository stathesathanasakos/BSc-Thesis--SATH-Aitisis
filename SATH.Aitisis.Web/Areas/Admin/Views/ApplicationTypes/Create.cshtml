@model SATH.Aitisis.Web.Areas.Admin.ViewModels.ApplicationTypes.CreateApplicationTypeViewModel

@{
    ViewData["Title"] = "Create Application Type";
}

<div class="admin-form-page">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-9">

            <div class="card admin-form-card">

                <div class="admin-form-card-header">

                    <div class="admin-form-icon admin-form-icon-orange">
                        A
                    </div>

                    <div>
                        <h5 class="mb-1">
                            Application Type Details
                        </h5>

                        <p class="mb-0">
                            Configure the basic information and optional fee for this application type.
                        </p>
                    </div>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name"
                                   class="form-label">
                                Application Type Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control admin-form-control"
                                   placeholder="e.g. Housing Benefit" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control admin-form-control"
                                      rows="4"
                                      placeholder="Describe what this application type is used for."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="admin-payment-panel mb-3">

                            <div class="form-check admin-form-check">
                                <input asp-for="RequiresPayment"
                                       class="form-check-input" />

                                <label asp-for="RequiresPayment"
                                       class="form-check-label">
                                    Requires Payment
                                </label>
                            </div>

                        </div>

                        <div class="mb-3">
                            <label asp-for="FeeAmount"
                                   class="form-label">
                                Fee Amount
                            </label>

                            <div class="input-group admin-money-input">
                                <span class="input-group-text">
                                    €
                                </span>

                                <input asp-for="FeeAmount"
                                       class="form-control admin-form-control"
                                       step="0.01"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="FeeAmount"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Required only when payment is enabled.
                            </div>
                        </div>

                        <div class="admin-form-actions mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Create Application Type
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}