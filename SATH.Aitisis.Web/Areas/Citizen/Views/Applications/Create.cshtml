@model SATH.Aitisis.Web.Areas.Citizen.ViewModels.Applications.SubmitApplicationViewModel
@using SATH.Aitisis.Domain.Enums

@{
    ViewData["Title"] = "Submit Application";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">
            @Model.ApplicationTypeName
        </h2>

        <p class="text-muted mb-0">
            Complete the information below to submit your application.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Applications
    </a>

</div>

@if (!string.IsNullOrWhiteSpace(Model.ApplicationTypeDescription))
{
    <div class="card mb-4">
        <div class="card-body">

            <h5 class="card-title">
                Application Information
            </h5>

            <p class="text-muted mb-3">
                @Model.ApplicationTypeDescription
            </p>

            @if (Model.RequiresPayment)
            {
                <span class="badge bg-warning text-dark">
                    Payment Required
                </span>

                @if (Model.FeeAmount.HasValue)
                {
                    <span class="badge bg-light text-dark border">
                        Fee: @Model.FeeAmount.Value.ToString("0.00") €
                    </span>
                }
            }
            else
            {
                <span class="badge bg-success">
                    No Payment Required
                </span>
            }

        </div>
    </div>
}

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <input asp-for="ApplicationTypeId"
           type="hidden" />

    <input asp-for="ApplicationTypeName"
           type="hidden" />

    <input asp-for="ApplicationTypeDescription"
           type="hidden" />

    <input asp-for="RequiresPayment"
           type="hidden" />

    <input asp-for="FeeAmount"
           type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <!-- APPLICATION FIELDS -->

    <div class="card mb-4">

        <div class="card-body">

            <h4 class="mb-1">
                Application Details
            </h4>

            <p class="text-muted mb-4">
                Fill in the information required for this application.
            </p>

            @if (Model.Fields.Count == 0)
            {
                <div class="alert alert-light border">
                    This application type does not require any additional information.
                </div>
            }
            else
            {
                @for (var i = 0; i < Model.Fields.Count; i++)
                {
                    <div class="mb-3">

                        <input asp-for="Fields[i].FieldId"
                               type="hidden" />

                        <input asp-for="Fields[i].Name"
                               type="hidden" />

                        <input asp-for="Fields[i].Label"
                               type="hidden" />

                        <input asp-for="Fields[i].FieldType"
                               type="hidden" />

                        <input asp-for="Fields[i].IsRequired"
                               type="hidden" />

                        <input asp-for="Fields[i].DisplayOrder"
                               type="hidden" />

                        <label class="form-label">

                            @Model.Fields[i].Label

                            @if (Model.Fields[i].IsRequired)
                            {
                                <span class="text-danger">*</span>
                            }

                        </label>

                        @switch (Model.Fields[i].FieldType)
                        {
                            case ApplicationFieldType.Text:

                                <input asp-for="Fields[i].Value"
                                       type="text"
                                       class="form-control" />

                                break;

                            case ApplicationFieldType.Number:

                                <input asp-for="Fields[i].Value"
                                       type="number"
                                       step="any"
                                       class="form-control" />

                                break;

                            case ApplicationFieldType.Date:

                                <input asp-for="Fields[i].Value"
                                       type="date"
                                       class="form-control" />

                                break;

                            case ApplicationFieldType.Boolean:

                                <div class="form-check">

                                    <input asp-for="Fields[i].Value"
                                           type="checkbox"
                                           value="true"
                                           class="form-check-input" />

                                    <label class="form-check-label">
                                        Yes
                                    </label>

                                </div>

                                break;
                        }

                    </div>
                }
            }

        </div>

    </div>

    <!-- OPTIONAL DESCRIPTION -->

    <div class="card mb-4">

        <div class="card-body">

            <h4 class="mb-1">
                Additional Information
            </h4>

            <p class="text-muted">
                You may provide any additional information relevant to your application.
            </p>

            <div class="mb-3">

                <label asp-for="Description"
                       class="form-label">
                    Additional Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>

    <!-- DOCUMENT REQUIREMENTS -->

    <div class="card mb-4">

        <div class="card-body">

            <h4 class="mb-1">
                Required Documents
            </h4>

            <p class="text-muted">
                The following documents are required for this application type.
            </p>

            @if (Model.DocumentRequirements.Count == 0)
            {
                <div class="alert alert-light border mb-0">
                    No supporting documents are required.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Document</th>
                                <th>Description</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var requirement in
                                                    Model.DocumentRequirements.OrderBy(x => x.DisplayOrder))
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @requirement.Name
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(requirement.Description))
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            @requirement.Description
                                        }
                                    </td>

                                    <td>
                                        @if (requirement.IsRequired)
                                        {
                                            <span class="badge bg-danger">
                                                Required
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Optional
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="alert alert-info mt-3 mb-0">
                    Document upload will be available in the next step.
                </div>
            }

        </div>

    </div>

    <!-- PAYMENT INFORMATION -->
    @if (Model.RequiresPayment)
    {
        <div class="card mb-4">

            <div class="card-body">

                <h4 class="mb-1">
                    Payment
                </h4>

                <p class="text-muted">
                    This application requires payment before the submission process is completed.
                </p>

                @if (Model.FeeAmount.HasValue)
                {
                    <div>
                        <strong>Application Fee:</strong>
                        @Model.FeeAmount.Value.ToString("0.00") €
                    </div>
                }

                <div class="alert alert-info mt-3 mb-0">
                    Payment will be handled in the payment step.
                </div>

            </div>

        </div>
    }

    <!-- SUBMIT -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-primary">
            Submit Application
        </button>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
