@model SATH.Aitisis.Web.Areas.Citizen.ViewModels.Applications.SubmitApplicationViewModel
@using SATH.Aitisis.Domain.Enums

@{
    ViewData["Title"] = "Submit Application";
}

<div class="citizen-submit-page">

    <div class="citizen-submit-hero mb-4">

        <div>
            <span class="citizen-page-eyebrow">
                New Application
            </span>

            <h1 class="citizen-page-title">
                @Model.ApplicationTypeName
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.ApplicationTypeDescription))
            {
                <p class="citizen-page-subtitle">
                    @Model.ApplicationTypeDescription
                </p>
            }
            else
            {
                <p class="citizen-page-subtitle">
                    Complete the required fields to continue to the document upload step.
                </p>
            }

            <div class="citizen-submit-hero-badges mt-3">

                @if (Model.RequiresPayment)
                {
                    <span class="citizen-soft-badge citizen-soft-badge-warning">
                        Payment Required
                    </span>

                    @if (Model.FeeAmount.HasValue)
                    {
                        <span class="citizen-soft-badge">
                            Fee: @Model.FeeAmount.Value.ToString("0.00") €
                        </span>
                    }
                }
                else
                {
                    <span class="citizen-soft-badge citizen-soft-badge-success">
                        No Payment Required
                    </span>
                }

                <span class="citizen-soft-badge">
                    @Model.DocumentRequirements.Count document requirement(s)
                </span>

            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary citizen-page-main-action">
            Back to Applications
        </a>

    </div>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="ApplicationTypeId"
               type="hidden" />

        <input asp-for="ApplicationTypeName"
               type="hidden" />

        <input asp-for="ApplicationTypeDescription"
               type="hidden" />

        <input asp-for="RequiresPayment"
               type="hidden" />

        <input asp-for="FeeAmount"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="row g-4">

            <div class="col-xl-8">

                <div class="card citizen-submit-card h-100">

                    <div class="citizen-submit-card-header">

                        <div>
                            <h5 class="mb-1">
                                Application Fields
                            </h5>

                            <p class="mb-0">
                                Fill in the information required for this application.
                            </p>
                        </div>

                        <span class="citizen-table-chip">
                            @Model.Fields.Count field(s)
                        </span>

                    </div>

                    <div class="card-body p-4">

                        @if (Model.Fields.Count == 0)
                        {
                            <div class="citizen-inline-empty">
                                This application type does not require any additional information.
                            </div>
                        }
                        else
                        {
                            <div class="citizen-submit-fields-grid">

                                @for (var i = 0; i < Model.Fields.Count; i++)
                                {
                                    <div class="citizen-submit-field-item">

                                        <input asp-for="Fields[i].FieldId"
                                               type="hidden" />

                                        <input asp-for="Fields[i].Name"
                                               type="hidden" />

                                        <input asp-for="Fields[i].Label"
                                               type="hidden" />

                                        <input asp-for="Fields[i].FieldType"
                                               type="hidden" />

                                        <input asp-for="Fields[i].IsRequired"
                                               type="hidden" />

                                        <input asp-for="Fields[i].DisplayOrder"
                                               type="hidden" />

                                        <label class="form-label">

                                            @Model.Fields[i].Label

                                            @if (Model.Fields[i].IsRequired)
                                            {
                                                <span class="text-danger">*</span>
                                            }

                                        </label>

                                        @switch (Model.Fields[i].FieldType)
                                        {
                                            case ApplicationFieldType.Text:

                                                <input asp-for="Fields[i].Value"
                                                       type="text"
                                                       class="form-control citizen-submit-control" />

                                                break;

                                            case ApplicationFieldType.Number:

                                                <input asp-for="Fields[i].Value"
                                                       type="number"
                                                       step="any"
                                                       class="form-control citizen-submit-control" />

                                                break;

                                            case ApplicationFieldType.Date:

                                                <input asp-for="Fields[i].Value"
                                                       type="date"
                                                       class="form-control citizen-submit-control" />

                                                break;

                                            case ApplicationFieldType.Boolean:

                                                <div class="form-check citizen-submit-check">

                                                    <input asp-for="Fields[i].Value"
                                                           type="checkbox"
                                                           value="true"
                                                           class="form-check-input" />

                                                    <label class="form-check-label">
                                                        Yes
                                                    </label>

                                                </div>

                                                break;
                                        }

                                    </div>
                                }

                            </div>
                        }

                        <div class="citizen-submit-description-panel mt-4">

                            <div>
                                <span class="citizen-page-eyebrow">
                                    Optional Information
                                </span>

                                <h5 class="mb-1">
                                    Additional Description
                                </h5>

                                <p class="mb-3">
                                    You may provide any additional information relevant to your application.
                                </p>
                            </div>

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control citizen-submit-control"
                                      rows="4"
                                      placeholder="Write any additional information here.">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-4">

                <div class="card citizen-submit-side-card mb-4">

                    <div class="citizen-submit-card-header">

                        <div>
                            <h5 class="mb-1">
                                Required PDFs
                            </h5>

                            <p class="mb-0">
                                Documents will be uploaded in the next step.
                            </p>
                        </div>

                    </div>

                    <div class="card-body p-4">

                        @if (Model.DocumentRequirements.Count == 0)
                        {
                            <div class="citizen-inline-empty">
                                No supporting documents are required.
                            </div>
                        }
                        else
                        {
                            <div class="citizen-required-documents-list">

                                @foreach (var requirement in Model.DocumentRequirements.OrderBy(x => x.DisplayOrder))
                                {
                                    <div class="citizen-required-document-item">

                                        <div class="citizen-required-document-icon">
                                            PDF
                                        </div>

                                        <div>
                                            <strong>
                                                @requirement.Name
                                            </strong>

                                            @if (string.IsNullOrWhiteSpace(requirement.Description))
                                            {
                                                <p>
                                                    No description provided.
                                                </p>
                                            }
                                            else
                                            {
                                                <p>
                                                    @requirement.Description
                                                </p>
                                            }

                                            @if (requirement.IsRequired)
                                            {
                                                <span class="badge citizen-status-badge citizen-status-rejected">
                                                    Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge citizen-status-badge citizen-status-neutral">
                                                    Optional
                                                </span>
                                            }
                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>

                @if (Model.RequiresPayment)
                {
                    <div class="citizen-payment-preview-panel">

                        <span class="citizen-page-eyebrow">
                            Payment Step
                        </span>

                        <h5>
                            Payment Required
                        </h5>

                        <p>
                            Payment will be handled after the required documents are uploaded.
                        </p>

                        @if (Model.FeeAmount.HasValue)
                        {
                            <strong>
                                @Model.FeeAmount.Value.ToString("0.00") €
                            </strong>
                        }

                    </div>
                }

            </div>

        </div>

        <div class="citizen-submit-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Continue
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}