@{
    ViewData["Title"] = "Application Submitted";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card text-center">
            <div class="card-body py-5">

                <div class="mb-3">
                    <span class="badge bg-success fs-6">
                        Submission Completed
                    </span>
                </div>

                <h2 class="mb-3">
                    Application Submitted Successfully
                </h2>

                <p class="text-muted">
                    Your application for
                    <strong>@ViewBag.ApplicationTypeName</strong>
                    has been submitted successfully.
                </p>

                <p>
                    Application ID:
                    <strong>#@ViewBag.ApplicationId</strong>
                </p>

                <div class="alert alert-info text-start mt-4">
                    Your application is now available for review by an employee.
                    A protocol number will be assigned if the application is approved.
                </div>

                <a asp-action="Index"
                   class="btn btn-primary mt-3">
                    Back to Applications
                </a>

            </div>
        </div>

    </div>
</div>