@{
    ViewData["Title"] = "Application Submitted";
}

<div class="citizen-confirmation-page">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card citizen-confirmation-card">

                <div class="card-body p-5 text-center">

                    <div class="citizen-confirmation-icon">
                        ✓
                    </div>

                    <h1 class="citizen-page-title mt-3">
                        Application Submitted Successfully
                    </h1>

                    <p class="citizen-page-subtitle mx-auto">
                        Your application for <strong>@ViewBag.ApplicationTypeName</strong> has been submitted successfully.
                    </p>

                    <div class="citizen-confirmation-reference">

                        <span>
                            Application ID
                        </span>

                        <strong>
                            #@ViewBag.ApplicationId
                        </strong>

                    </div>

                    <div class="citizen-confirmation-info-panel">

                        <div class="citizen-confirmation-info-icon">
                            i
                        </div>

                        <div class="text-start">
                            <strong>
                                What happens next?
                            </strong>

                            <p>
                                Your application is now available for review by an employee.
                                A protocol number will be assigned if the application is approved.
                            </p>
                        </div>

                    </div>

                    <div class="citizen-confirmation-actions">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            New Application
                        </a>

                        <a asp-action="MyApplications"
                           class="btn btn-primary">
                            View My Applications
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>