@model SATH.Aitisis.Web.Areas.Citizen.ViewModels.Applications.ApplicationDocumentsViewModel

@{
    ViewData["Title"] = "Supporting Documents";
}

<div class="citizen-documents-page">

    <div class="citizen-documents-hero mb-4">
        <div>
            <span class="citizen-page-eyebrow">
                Document Upload - Supporting documents
            </span>

            <p class="citizen-page-subtitle">
                Upload the required PDF documents for <strong>@Model.ApplicationTypeName</strong>.
            </p>
        </div>

        <form asp-area="Citizen"
              asp-controller="Applications"
              asp-action="GenerateDocumentGuidance"
              method="post"
              class="mb-0">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="applicationId"
                   value="@Model.ApplicationId" />

            <button type="submit"
                    class="btn btn-outline-primary citizen-page-main-action">
                Get AI Document Guidance
            </button>

        </form>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card citizen-documents-card">

        <div class="citizen-documents-card-header">

            <div>
                <h5 class="mb-1">
                    Document Requirements
                </h5>

                <p class="mb-0">
                    Required documents must be uploaded before you can continue. Only PDF files up to 10 MB are accepted.
                </p>
            </div>

            @if (Model.RequiredDocumentsCompleted)
            {
                <span class="citizen-soft-badge citizen-soft-badge-success">
                    Required Documents Completed
                </span>
            }
            else
            {
                <span class="citizen-soft-badge citizen-soft-badge-warning">
                    Documents Pending
                </span>
            }

        </div>

        <div class="card-body p-4">

            @if (Model.AiDocumentGuidance != null)
            {
                <div class="modal fade"
                     id="aiDocumentGuidanceModal"
                     tabindex="-1"
                     aria-labelledby="aiDocumentGuidanceModalLabel"
                     aria-hidden="true">

                    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

                        <div class="modal-content citizen-ai-guidance-modal">

                            <div class="modal-header citizen-ai-guidance-modal-header">

                                <div>
                                    <span class="citizen-page-eyebrow">
                                        AI Document Guidance
                                    </span>

                                    <h5 class="modal-title"
                                        id="aiDocumentGuidanceModalLabel">
                                        Suggested preparation steps
                                    </h5>
                                </div>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close">
                                </button>

                            </div>

                            <div class="modal-body citizen-ai-guidance-modal-body">

                                @if (!string.IsNullOrWhiteSpace(Model.AiDocumentGuidance.Summary))
                                {
                                    <div class="citizen-ai-guidance-modal-summary">
                                        @Model.AiDocumentGuidance.Summary
                                    </div>
                                }

                                <div class="citizen-ai-guidance-list">

                                    @foreach (var item in Model.AiDocumentGuidance.Items)
                                    {
                                        <div class="citizen-ai-guidance-item">

                                            <h6>
                                                @item.DocumentName
                                            </h6>

                                            @if (item.Steps.Count == 0)
                                            {
                                                <p class="mb-0 text-muted">
                                                    No specific steps were returned for this document.
                                                </p>
                                            }
                                            else
                                            {
                                                <ol>
                                                    @foreach (var step in item.Steps)
                                                    {
                                                        <li>
                                                            @step
                                                        </li>
                                                    }
                                                </ol>
                                            }

                                        </div>
                                    }

                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.AiDocumentGuidance.GeneralAdvice))
                                {
                                    <div class="citizen-ai-guidance-note mt-3">
                                        <strong>
                                            General advice
                                        </strong>

                                        <p>
                                            @Model.AiDocumentGuidance.GeneralAdvice
                                        </p>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.AiDocumentGuidance.Disclaimer))
                                {
                                    <div class="citizen-ai-guidance-disclaimer mt-3">
                                        @Model.AiDocumentGuidance.Disclaimer
                                    </div>
                                }

                            </div>

                            <div class="modal-footer citizen-ai-guidance-modal-footer">

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        data-bs-dismiss="modal">
                                    Close
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }

            @if (Model.DocumentRequirements.Count == 0)
            {
                <div class="citizen-inline-empty">

                    <h5 class="mb-1">
                        No supporting documents required
                    </h5>

                    <p class="mb-0">
                        This application type does not require any supporting PDF documents.
                    </p>

                </div>
            }
            else
            {
                <div class="citizen-upload-list">

                    @foreach (var requirement in Model.DocumentRequirements.OrderBy(x => x.DisplayOrder))
                    {
                        <div class="citizen-upload-item @(requirement.IsUploaded ? "is-uploaded" : "is-pending")">

                            <div class="citizen-upload-icon">
                                @if (requirement.IsUploaded)
                                {
                                    <span>✓</span>
                                }
                                else
                                {
                                    <span>PDF</span>
                                }
                            </div>

                            <div class="citizen-upload-content">

                                <div class="citizen-upload-title-row">

                                    <div>
                                        <h5>
                                            @requirement.Name
                                        </h5>

                                        @if (string.IsNullOrWhiteSpace(requirement.Description))
                                        {
                                            <p>
                                                No description provided.
                                            </p>
                                        }
                                        else
                                        {
                                            <p>
                                                @requirement.Description
                                            </p>
                                        }
                                    </div>

                                    @if (requirement.IsRequired)
                                    {
                                        <span class="badge citizen-status-badge citizen-status-rejected">
                                            Required
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge citizen-status-badge citizen-status-neutral">
                                            Optional
                                        </span>
                                    }

                                </div>

                                @if (requirement.IsUploaded)
                                {
                                    <div class="citizen-uploaded-state">

                                        <span class="badge citizen-status-badge citizen-status-approved">
                                            Uploaded ✓
                                        </span>

                                        <span>
                                            Document successfully received.
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <form asp-area="Citizen"
                                          asp-controller="Applications"
                                          asp-action="UploadDocument"
                                          method="post"
                                          enctype="multipart/form-data"
                                          class="citizen-upload-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="ApplicationId"
                                               value="@Model.ApplicationId" />

                                        <input type="hidden"
                                               name="ApplicationTypeId"
                                               value="@Model.ApplicationTypeId" />

                                        <input type="hidden"
                                               name="DocumentRequirementId"
                                               value="@requirement.Id" />

                                        <div class="input-group">

                                            <input type="file"
                                                   name="File"
                                                   accept=".pdf,application/pdf"
                                                   class="form-control citizen-submit-control"
                                                   required />

                                            <button type="submit"
                                                    class="btn btn-outline-primary">
                                                Upload
                                            </button>

                                        </div>

                                    </form>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

        <div class="citizen-submit-actions citizen-documents-actions">

            <div class="citizen-documents-secondary-actions">

                <form asp-area="Citizen"
                      asp-controller="Applications"
                      asp-action="CancelDraft"
                      method="post"
                      class="mb-0">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="applicationId"
                           value="@Model.ApplicationId" />

                    <button type="submit"
                            class="btn btn-outline-secondary"
                            onclick="return confirm('Are you sure you want to cancel this application draft?');">
                        Cancel
                    </button>

                </form>

                <form asp-area="Citizen"
                      asp-controller="Applications"
                      asp-action="CancelDraft"
                      method="post"
                      class="mb-0">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="applicationId"
                           value="@Model.ApplicationId" />

                    <button type="submit"
                            class="btn btn-outline-secondary"
                            onclick="return confirm('Going back will cancel this application draft. Continue?');">
                        Back to Applications
                    </button>

                </form>

            </div>

            @if (Model.RequiredDocumentsCompleted)
            {
                <form asp-area="Citizen"
                      asp-controller="Applications"
                      asp-action="ContinueSubmission"
                      method="post"
                      class="mb-0">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="applicationId"
                           value="@Model.ApplicationId" />

                    <button type="submit"
                            class="btn btn-primary">
                        Continue
                    </button>

                </form>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary"
                        disabled>
                    Continue
                </button>
            }

        </div>

    </div>

</div>


@if (Model.AiDocumentGuidance != null)
{
    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const modalElement = document.getElementById('aiDocumentGuidanceModal');

                if (modalElement) {
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
            });
        </script>
    }
}