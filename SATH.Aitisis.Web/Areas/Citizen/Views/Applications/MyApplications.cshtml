@model IReadOnlyCollection<SATH.Aitisis.Web.Areas.Citizen.ViewModels.Applications.MyApplicationListItemViewModel>

@{
    ViewData["Title"] = "My Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">
            My Applications
        </h2>

        <p class="text-muted mb-0">
            View the applications you have submitted and their current status.
        </p>
    </div>

    <a asp-area="Citizen"
       asp-controller="Applications"
       asp-action="Index"
       class="btn btn-primary">
        New Application
    </a>

</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">

            <h5 class="mb-2">
                No applications found
            </h5>

            <p class="text-muted">
                You have not submitted any applications yet.
            </p>

            <a asp-area="Citizen"
               asp-controller="Applications"
               asp-action="Index"
               class="btn btn-primary">
                Start an Application
            </a>

        </div>
    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Application</th>
                            <th>Submitted On</th>
                            <th>Status</th>
                            <th>Protocol Number</th>
                            <th>Decision Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var application in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @application.ApplicationTypeName
                                </td>

                                <td>
                                    @(application.SubmissionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>
                                    <span class="badge @application.StatusCssClass">
                                        @application.StatusText
                                    </span>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(application.ProtocolNumber))
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                    else
                                    {
                                        @application.ProtocolNumber
                                    }
                                </td>

                                <td>
                                    @if (application.DecisionDate.HasValue)
                                    {
                                        @(application.DecisionDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">

                                        <a asp-area="Citizen"
                                           asp-controller="Applications"
                                           asp-action="Timeline"
                                           asp-route-id="@application.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Timeline
                                        </a>

                                        @if (application.StatusText == "Approved" &&
                                                                        !string.IsNullOrWhiteSpace(application.ProtocolNumber))
                                        {
                                            <a asp-area="Citizen"
                                               asp-controller="Applications"
                                               asp-action="DownloadCertificate"
                                               asp-route-id="@application.Id"
                                               class="btn btn-sm btn-outline-success">
                                                Download Certificate
                                            </a>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}