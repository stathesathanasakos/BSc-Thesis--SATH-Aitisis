@model IReadOnlyCollection<SATH.Aitisis.Web.Areas.Citizen.ViewModels.Applications.AvailableApplicationTypeViewModel>

@{
    ViewData["Title"] = "Available Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Available Applications</h2>
        <p class="text-muted mb-0">
            Select an application type to start a new application.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h5 class="card-title">
                No applications available
            </h5>

            <p class="text-muted mb-0">
                There are currently no active application types available for submission.
            </p>
        </div>
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var applicationType in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @applicationType.Name
                        </h5>

                        @if (!string.IsNullOrWhiteSpace(applicationType.Description))
                        {
                            <p class="card-text text-muted">
                                @applicationType.Description
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-muted">
                                No description available.
                            </p>
                        }

                        <div class="mb-3">
                            @if (applicationType.RequiresPayment)
                            {
                                <span class="badge bg-warning text-dark">
                                    Payment Required
                                </span>

                                @if (applicationType.FeeAmount.HasValue)
                                {
                                    <span class="badge bg-light text-dark border">
                                        @applicationType.FeeAmount.Value.ToString("0.00") €
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    No Payment Required
                                </span>
                            }
                        </div>

                        <div class="mt-auto">
                            <a asp-action="Create"
                               asp-route-id="@applicationType.Id"
                               class="btn btn-primary w-100">
                                Start Application
                            </a>
                        </div>

                    </div>

                </div>
            </div>
        }

    </div>
}
