@model IReadOnlyCollection<SATH.Aitisis.Web.Areas.Citizen.ViewModels.Applications.AvailableApplicationTypeViewModel>

@{
    ViewData["Title"] = "Available Applications";

    const int pageSize = 6;

    var pageQuery = Context.Request.Query["page"].ToString();

    var currentPage = int.TryParse(pageQuery, out var parsedPage) && parsedPage > 0
        ? parsedPage
        : 1;

    var totalItems = Model.Count;

    var totalPages = totalItems == 0
        ? 1
        : (int)Math.Ceiling((double)totalItems / pageSize);

    if (currentPage > totalPages)
    {
        currentPage = totalPages;
    }

    var applicationTypes = Model
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    var firstItemNumber = totalItems == 0
        ? 0
        : ((currentPage - 1) * pageSize) + 1;

    var lastItemNumber = Math.Min(currentPage * pageSize, totalItems);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Select an application type to start a new application</h2>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h5 class="card-title">
                No applications available
            </h5>

            <p class="text-muted mb-0">
                There are currently no active application types available for submission.
            </p>
        </div>
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var applicationType in applicationTypes)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @applicationType.Name
                        </h5>

                        @if (!string.IsNullOrWhiteSpace(applicationType.Description))
                        {
                            <p class="card-text text-muted">
                                @applicationType.Description
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-muted">
                                No description available.
                            </p>
                        }

                        <div class="mb-3">
                            @if (applicationType.RequiresPayment)
                            {
                                <span class="badge bg-warning text-dark">
                                    Payment Required
                                </span>

                                @if (applicationType.FeeAmount.HasValue)
                                {
                                    <span class="badge bg-light text-dark border">
                                        @applicationType.FeeAmount.Value.ToString("0.00") €
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    No Payment Required
                                </span>
                            }
                        </div>

                        <div class="mt-auto">
                            <a asp-action="Create"
                               asp-route-id="@applicationType.Id"
                               class="btn btn-primary w-100">
                                Start Application
                            </a>
                        </div>

                    </div>

                </div>
            </div>
        }

    </div>

    @if (totalPages > 1)
    {
        <div class="citizen-available-applications-pagination">

            <div class="citizen-pagination-summary">
                Showing @firstItemNumber-@lastItemNumber of @totalItems
            </div>

            <div class="citizen-pagination-actions">

                @if (currentPage > 1)
                {
                    <a asp-area="Citizen"
                       asp-controller="Applications"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       class="btn btn-outline-primary">
                        Previous
                    </a>
                }
                else
                {
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled>
                        Previous
                    </button>
                }

                @if (currentPage < totalPages)
                {
                    <a asp-area="Citizen"
                       asp-controller="Applications"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       class="btn btn-primary">
                        Next
                    </a>
                }
                else
                {
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled>
                        Next
                    </button>
                }

            </div>

        </div>
    }
}