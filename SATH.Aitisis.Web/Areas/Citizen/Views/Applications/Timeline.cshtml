@model SATH.Aitisis.Web.ViewModels.Applications.ApplicationTimelineViewModel
@using SATH.Aitisis.Domain.Enums

@{
    ViewData["Title"] = "Application Timeline";

    var statusText = Model.Status == ApplicationStatus.Submitted
        ? "Pending"
        : Model.Status.ToString();

    var statusCssClass = Model.Status == ApplicationStatus.Submitted
        ? "citizen-status-pending"
        : Model.Status == ApplicationStatus.Approved
            ? "citizen-status-approved"
            : Model.Status == ApplicationStatus.Rejected
                ? "citizen-status-rejected"
                : "citizen-status-neutral";
}

<div class="citizen-timeline-page">

    <div class="citizen-timeline-hero mb-4">

        <div>
            <span class="citizen-page-eyebrow">
                Application Lifecycle
            </span>

            <p class="citizen-page-subtitle">
                Review the lifecycle of your submitted application and follow each recorded event.
            </p>
        </div>

        <a asp-area="Citizen"
           asp-controller="Applications"
           asp-action="MyApplications"
           class="btn btn-outline-secondary citizen-page-main-action">
            Back to My Applications
        </a>

    </div>

    <div class="card citizen-timeline-summary-card mb-4">

        <div class="card-body p-4">

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="citizen-timeline-summary-item">
                        <span>
                            Application ID
                        </span>

                        <strong>
                            #@Model.ApplicationId
                        </strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="citizen-timeline-summary-item">
                        <span>
                            Application Type
                        </span>

                        <strong>
                            @Model.ApplicationTypeName
                        </strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="citizen-timeline-summary-item">
                        <span>
                            Current Status
                        </span>

                        <strong>
                            <span class="badge citizen-status-badge @statusCssClass">
                                @statusText
                            </span>
                        </strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ProtocolNumber))
                {
                    <div class="col-12">
                        <div class="citizen-protocol-panel">
                            <span>
                                Protocol Number
                            </span>

                            <strong>
                                @Model.ProtocolNumber
                            </strong>
                        </div>
                    </div>
                }

            </div>

        </div>

    </div>

    <div class="card citizen-timeline-card">

        <div class="citizen-timeline-card-header">

            <div>
                <h5 class="mb-1">
                    Timeline Events
                </h5>

                <p class="mb-0">
                    Chronological activity recorded for your application.
                </p>
            </div>

            <span class="citizen-table-chip">
                @Model.Items.Count event(s)
            </span>

        </div>

        <div class="card-body p-4">

            @if (!Model.Items.Any())
            {
                <div class="citizen-inline-empty">
                    No timeline events are available.
                </div>
            }
            else
            {
                <div class="citizen-timeline-list">

                    @foreach (var item in Model.Items)
                    {
                        <div class="citizen-timeline-item">

                            <div class="citizen-timeline-marker citizen-timeline-marker-@item.CssClass">
                            </div>

                            <div class="citizen-timeline-content">

                                <div class="citizen-timeline-content-header">
                                    <h6>
                                        @item.Title
                                    </h6>

                                    <span>
                                        @item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                                <p>
                                    @item.Description
                                </p>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>