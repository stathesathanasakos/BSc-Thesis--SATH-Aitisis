@model int

@{
    ViewData["Title"] = "Payment Completed";
}

<div class="citizen-payment-result-page">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card citizen-confirmation-card citizen-payment-result-card">

                <div class="card-body p-5 text-center">

                    <div class="citizen-confirmation-icon">
                        ✓
                    </div>

                    <h1 class="citizen-page-title mt-3">
                        Your payment was completed successfully
                    </h1>

                    <p class="citizen-page-subtitle mx-auto">
                        The application fee has been confirmed through the Stripe test payment flow.
                    </p>

                    <div class="citizen-confirmation-reference">

                        <span>
                            Application ID
                        </span>

                        <strong>
                            #@Model
                        </strong>

                    </div>

                    <div class="citizen-confirmation-info-panel">

                        <div class="citizen-confirmation-info-icon">
                            i
                        </div>

                        <div class="text-start">
                            <strong>
                                What happens next?
                            </strong>

                            <p>
                                Your application is now ready for employee review.
                                You can follow its progress from your application history.
                            </p>
                        </div>

                    </div>

                    <div class="citizen-confirmation-actions">

                        <a asp-area="Citizen"
                           asp-controller="Payments"
                           asp-action="Details"
                           asp-route-applicationId="@Model"
                           class="btn btn-outline-secondary">
                            View Payment Details
                        </a>

                        <a asp-area="Citizen"
                           asp-controller="Applications"
                           asp-action="MyApplications"
                           class="btn btn-primary">
                            Go to My Applications
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>