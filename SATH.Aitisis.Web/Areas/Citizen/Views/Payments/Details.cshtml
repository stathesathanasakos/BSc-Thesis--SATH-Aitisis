@model SATH.Aitisis.Web.Areas.Citizen.ViewModels.Payments.PaymentDetailsViewModel

@{
    ViewData["Title"] = "Application Payment";
}

<div class="mb-4">
    <h2 class="mb-1">
        Application Payment
    </h2>

    <p class="text-muted mb-0">
        Review the required application fee and continue to the secure
        Stripe test checkout page.
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row g-4">

    <div class="col-lg-7">
        <div class="card shadow-sm">

            <div class="card-header bg-light">
                <h5 class="mb-0">
                    Payment Details
                </h5>
            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        Application
                    </dt>
                    <dd class="col-sm-8">
                        @Model.ApplicationTypeName
                    </dd>

                    <dt class="col-sm-4">
                        Amount
                    </dt>
                    <dd class="col-sm-8">
                        @Model.Amount.ToString("0.00") @Model.Currency.ToUpperInvariant()
                    </dd>

                    <dt class="col-sm-4">
                        Payment Status
                    </dt>
                    <dd class="col-sm-8">
                        @if (Model.PaymentStatusText == "Completed")
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else if (Model.PaymentStatusText == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.PaymentStatusText == "Failed")
                        {
                            <span class="badge bg-danger">
                                Failed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.PaymentStatusText
                            </span>
                        }
                    </dd>

                </dl>

            </div>

        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm h-100">

            <div class="card-header bg-light">
                <h5 class="mb-0">
                    Action
                </h5>
            </div>

            <div class="card-body d-flex flex-column">

                @if (!Model.RequiresPayment)
                {
                    <div class="alert alert-light border">
                        This application type does not require payment.
                    </div>

                    <div class="mt-auto">
                        <a asp-area="Citizen"
                           asp-controller="Applications"
                           asp-action="MyApplications"
                           class="btn btn-outline-secondary">
                            Back to My Applications
                        </a>
                    </div>
                }
                else if (Model.PaymentStatusText == "Completed")
                {
                    <div class="alert alert-success">
                        This application fee has already been paid.
                    </div>

                    <div class="mt-auto">
                        <a asp-area="Citizen"
                           asp-controller="Applications"
                           asp-action="MyApplications"
                           class="btn btn-outline-primary">
                            Back to My Applications
                        </a>
                    </div>
                }
                else if (Model.CanStartPayment)
                {
                    <p class="text-muted">
                        You will be redirected to Stripe Checkout in test mode.
                        No real money will be transferred.
                    </p>

                    <form asp-area="Citizen"
                          asp-controller="Payments"
                          asp-action="Start"
                          method="post"
                          class="mt-auto">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="applicationId"
                               value="@Model.ApplicationId" />

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Pay Fee with Stripe
                        </button>

                    </form>
                }
                else
                {
                    <div class="alert alert-warning">
                        Payment cannot be started for this application.
                    </div>

                    <div class="mt-auto">
                        <a asp-area="Citizen"
                           asp-controller="Applications"
                           asp-action="MyApplications"
                           class="btn btn-outline-secondary">
                            Back to My Applications
                        </a>
                    </div>
                }

            </div>

        </div>
    </div>

</div>