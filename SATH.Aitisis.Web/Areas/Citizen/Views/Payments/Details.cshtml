@model SATH.Aitisis.Web.Areas.Citizen.ViewModels.Payments.PaymentDetailsViewModel

@{
    ViewData["Title"] = "Application Payment";

    var paymentStatusCssClass = Model.PaymentStatusText == "Completed"
        ? "citizen-status-approved"
        : Model.PaymentStatusText == "Pending"
            ? "citizen-status-pending"
            : Model.PaymentStatusText == "Failed"
                ? "citizen-status-rejected"
                : "citizen-status-neutral";
}

<div class="citizen-payment-page">

    <div class="citizen-payment-hero mb-4">

        <div>
            <span class="citizen-page-eyebrow">
                Payment Step
            </span>

            <p class="citizen-page-subtitle">
                Review the required application fee and feel free continue to the secure Stripe checkout page.
            </p>
        </div>

        <a asp-area="Citizen"
           asp-controller="Applications"
           asp-action="MyApplications"
           class="btn btn-outline-secondary citizen-page-main-action">
            Back to My Applications
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="row g-4">

        <div class="col-xl-7">

            <div class="card citizen-payment-card h-100">

                <div class="citizen-payment-card-header">

                    <div>
                        <h5 class="mb-1">
                            Payment Details
                        </h5>

                        <p class="mb-0">
                            Payment data calculated by the application before checkout.
                        </p>
                    </div>

                    <span class="badge citizen-status-badge @paymentStatusCssClass">
                        @Model.PaymentStatusText
                    </span>

                </div>

                <div class="card-body p-4">

                    <div class="citizen-payment-details-grid">

                        <div class="citizen-payment-detail-item">
                            <span>
                                Application
                            </span>

                            <strong>
                                @Model.ApplicationTypeName
                            </strong>
                        </div>

                        <div class="citizen-payment-detail-item">
                            <span>
                                Application ID
                            </span>

                            <strong>
                                #@Model.ApplicationId
                            </strong>
                        </div>

                        <div class="citizen-payment-detail-item citizen-payment-detail-amount">
                            <span>
                                Amount
                            </span>

                            <strong>
                                @Model.Amount.ToString("0.00") @Model.Currency.ToUpperInvariant()
                            </strong>
                        </div>

                        <div class="citizen-payment-detail-item">
                            <span>
                                Payment Status
                            </span>

                            <strong>
                                <span class="badge citizen-status-badge @paymentStatusCssClass">
                                    @Model.PaymentStatusText
                                </span>
                            </strong>
                        </div>

                    </div>

                    <div class="citizen-payment-security-panel mt-4">

                        <div class="citizen-payment-security-icon">
                            S
                        </div>

                        <div>
                            <strong>
                                Stripe test checkout
                            </strong>

                            <p>
                                You will be redirected to a hosted Stripe Checkout page in test mode.
                                No real money will be transferred.
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-5">

            <div class="card citizen-payment-card h-100">

                <div class="citizen-payment-card-header">

                    <div>
                        <h5 class="mb-1">
                            Payment Action
                        </h5>

                        <p class="mb-0">
                            Continue based on the current payment state.
                        </p>
                    </div>

                </div>

                <div class="card-body p-4 d-flex flex-column">

                    @if (!Model.RequiresPayment)
                    {
                        <div class="citizen-payment-state-panel citizen-payment-state-neutral">

                            <span class="citizen-soft-badge citizen-soft-badge-success">
                                No Payment Required
                            </span>

                            <h5>
                                No fee is required
                            </h5>

                            <p>
                                This application type does not require payment.
                            </p>

                        </div>

                        <div class="mt-auto pt-4">
                            <a asp-area="Citizen"
                               asp-controller="Applications"
                               asp-action="MyApplications"
                               class="btn btn-outline-secondary w-100">
                                Back to My Applications
                            </a>
                        </div>
                    }
                    else if (Model.PaymentStatusText == "Completed")
                    {
                        <div class="citizen-payment-state-panel citizen-payment-state-success">

                            <span class="citizen-soft-badge citizen-soft-badge-success">
                                Completed
                            </span>

                            <h5>
                                Payment already completed
                            </h5>

                            <p>
                                This application fee has already been paid and confirmed.
                            </p>

                        </div>

                        <div class="mt-auto pt-4">
                            <a asp-area="Citizen"
                               asp-controller="Applications"
                               asp-action="MyApplications"
                               class="btn btn-primary w-100">
                                Back to My Applications
                            </a>
                        </div>
                    }
                    else if (Model.CanStartPayment)
                    {
                        <div class="citizen-payment-state-panel citizen-payment-state-warning">

                            <span class="citizen-soft-badge citizen-soft-badge-warning">
                                Payment Required
                            </span>

                            <h5>
                                Continue to checkout
                            </h5>

                            <p>
                                The payment will be processed through Stripe Checkout in test mode.
                            </p>

                        </div>

                        <form asp-area="Citizen"
                              asp-controller="Payments"
                              asp-action="Start"
                              method="post"
                              class="mt-auto pt-4">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="applicationId"
                                   value="@Model.ApplicationId" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Pay Fee with Stripe
                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="citizen-payment-state-panel citizen-payment-state-warning">

                            <span class="citizen-soft-badge citizen-soft-badge-warning">
                                Unavailable
                            </span>

                            <h5>
                                Payment cannot be started
                            </h5>

                            <p>
                                Payment cannot currently be started for this application.
                            </p>

                        </div>

                        <div class="mt-auto pt-4">
                            <a asp-area="Citizen"
                               asp-controller="Applications"
                               asp-action="MyApplications"
                               class="btn btn-outline-secondary w-100">
                                Back to My Applications
                            </a>
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>