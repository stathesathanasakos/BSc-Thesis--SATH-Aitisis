@model SATH.Aitisis.Web.Areas.Citizen.ViewModels.Dashboard.CitizenDashboardViewModel

@{
    ViewData["Title"] = "Citizen Dashboard";
}

<div class="mb-4">
    <h2 class="mb-1">
        Citizen Dashboard
    </h2>

    <p class="text-muted mb-0">
        Submit new applications and monitor the applications you have already
        submitted.
    </p>
</div>

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-1">
                    My Applications
                </p>

                <h2 class="mb-0">
                    @Model.TotalApplications
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-warning">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Pending
                </p>

                <h2 class="mb-0">
                    @Model.PendingApplications
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-success">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Approved
                </p>

                <h2 class="mb-0">
                    @Model.ApprovedApplications
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-danger">
            <div class="card-body">
                <p class="text-muted mb-1">
                    Rejected
                </p>

                <h2 class="mb-0">
                    @Model.RejectedApplications
                </h2>
            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <!-- New Application -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">

            <div class="card-body d-flex flex-column">

                <h4 class="card-title">
                    New Application
                </h4>

                <p class="card-text text-muted">
                    View the available application types and start a new
                    application with the required information and documents.
                </p>

                <div class="mt-auto">
                    <a asp-area="Citizen"
                       asp-controller="Applications"
                       asp-action="Index"
                       class="btn btn-primary">
                        Start Application
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- My Applications -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">

            <div class="card-body d-flex flex-column">

                <h4 class="card-title">
                    My Applications
                </h4>

                <p class="card-text text-muted">
                    View your submitted applications, current status, decision
                    date and protocol number.
                </p>

                <div class="mt-auto">
                    <a asp-area="Citizen"
                       asp-controller="Applications"
                       asp-action="MyApplications"
                       class="btn btn-outline-primary">
                        View My Applications
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Account Settings -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-danger">

            <div class="card-body d-flex flex-column">

                <h4 class="card-title">
                    Account Settings
                </h4>

                <p class="card-text text-muted">
                    Deactivate your citizen account if you no longer wish
                    to use the application.
                </p>

                <div class="mt-auto">
                    <a asp-area="Citizen"
                       asp-controller="Account"
                       asp-action="Deactivate"
                       class="btn btn-outline-danger">
                        Deactivate Account
                    </a>
                </div>

            </div>
        </div>
    </div>

</div>

<div class="alert alert-light border mt-4">
    Application status information, protocol numbers and decision dates
    appear in the My Applications page as the application progresses.
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        @await Component.InvokeAsync("DashboardCalendar")
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">

            <div class="card-header bg-light">
                <h5 class="mb-0">
                    Citizen Activity Guide
                </h5>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    Use your dashboard to submit new applications, monitor
                    application progress and access your application history.
                </p>

                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <span class="badge bg-light text-dark border me-2">
                            1
                        </span>
                        Start a new application.
                    </li>

                    <li class="mb-2">
                        <span class="badge bg-light text-dark border me-2">
                            2
                        </span>
                        Upload the required PDF documents.
                    </li>

                    <li>
                        <span class="badge bg-light text-dark border me-2">
                            3
                        </span>
                        Follow decisions, protocol numbers and certificates.
                    </li>
                </ul>
            </div>

        </div>
    </div>
</div>