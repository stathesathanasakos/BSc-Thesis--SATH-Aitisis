@{
    ViewData["Title"] = "Deactivate Account";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm border-danger">

            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">
                    Deactivate Account
                </h4>
            </div>

            <div class="card-body">

                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }

                <div class="alert alert-danger">
                    <h5 class="alert-heading">
                        This is a serious account action
                    </h5>

                    <p>
                        You are about to deactivate your citizen account.
                        After this action is completed, you will no longer be
                        able to sign in or use the citizen services of the
                        application.
                    </p>

                    <hr />

                    <p class="mb-0">
                        This action cannot be reversed by you from inside the
                        application. If reactivation is ever required, it must
                        be handled by the organization/system administrator.
                    </p>
                </div>

                <div class="alert alert-warning">
                    <strong>Your existing data will not be deleted.</strong>

                    <p class="mb-0 mt-2">
                        Your submitted applications, uploaded documents,
                        application decisions, protocol numbers and related
                        history will remain stored in the system for
                        administrative, legal and review purposes.
                    </p>
                </div>

                <p class="text-muted">
                    Choose cancel if you are not completely sure that you want
                    to deactivate your account.
                </p>

                <form asp-area="Citizen"
                      asp-controller="Account"
                      asp-action="DeactivateConfirmed"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="form-check mb-4">
                        <input class="form-check-input"
                               type="checkbox"
                               id="confirmDeactivation"
                               required />

                        <label class="form-check-label"
                               for="confirmDeactivation">
                            I understand that deactivating my account is a
                            serious action and that I will not be able to sign
                            in again after completion.
                        </label>
                    </div>

                    <div class="d-flex gap-2">

                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Final confirmation: are you sure you want to deactivate your account?');">
                            Deactivate My Account
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>