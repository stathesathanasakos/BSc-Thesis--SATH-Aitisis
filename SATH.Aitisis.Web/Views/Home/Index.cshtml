@using SATH.Aitisis.App.Common.Constants

@{
    ViewData["Title"] = "Home";

    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isEmployee = User.IsInRole(AppRoles.Employee);
    var isCitizen = User.IsInRole(AppRoles.Citizen);

    var roleTitle = isAdmin
        ? "Administrator"
        : isEmployee
            ? "Employee"
            : isCitizen
                ? "Citizen"
                : "User";

    var welcomeTitle = isAdmin
        ? "Welcome to your administration workspace"
        : isEmployee
            ? "Welcome to your review workspace"
            : isCitizen
                ? "Welcome to your citizen services workspace"
                : "Welcome to SATH-Aitisis";

    var welcomeText = isAdmin
        ? "Manage employees and configure the available application types."
        : isEmployee
            ? "Review submitted applications, inspect supporting documents and use the AI assistant to focus your review."
            : isCitizen
                ? "Submit applications and track your application progress."
                : "Access the electronic application submission and review system.";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="home-landing">

        <div class="row g-4 align-items-stretch">

            <div class="col-xl-7">

                <div class="card home-welcome-card h-100">

                    <div class="card-body p-4 p-lg-5">

                        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

                            <div>
                                <span class="home-eyebrow">
                                    SATH-Aitisis Portal
                                </span>

                                <h1 class="home-title mt-2 mb-3">
                                    @welcomeTitle
                                </h1>

                                <p class="home-subtitle mb-0">
                                    @welcomeText
                                </p>
                            </div>

                            <span class="home-role-badge">
                                @roleTitle
                            </span>

                        </div>

                        <div class="home-user-panel mb-4">

                            <div class="home-user-avatar">
                                @roleTitle.Substring(0, 1)
                            </div>

                            <div>
                                <div class="home-user-label">
                                    Signed in as
                                </div>

                                <div class="home-user-name">
                                    @User.Identity?.Name
                                </div>
                            </div>

                        </div>

                        @if (isAdmin)
                        {
                            <div class="row g-3 mb-0">

                                <div class="col-md-6">
                                    <div class="home-admin-action-block h-100">

                                        <div class="home-step-card">
                                            <div class="home-step-number">
                                                1
                                            </div>

                                            <div class="home-step-title">
                                                Manage employees
                                            </div>

                                            <p class="home-step-text">
                                                Create, deactivate and reactivate employee accounts.
                                            </p>
                                        </div>

                                        <div class="home-admin-action-footer">
                                            <a asp-area="Admin"
                                               asp-controller="Employees"
                                               asp-action="Index"
                                               class="btn btn-primary">
                                                Manage Employees
                                            </a>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="home-admin-action-block h-100">

                                        <div class="home-step-card">
                                            <div class="home-step-number">
                                                2
                                            </div>

                                            <div class="home-step-title">
                                                Configure types
                                            </div>

                                            <p class="home-step-text">
                                                Maintain application types, fields and document requirements.
                                            </p>
                                        </div>

                                        <div class="home-admin-action-footer">
                                            <a asp-area="Admin"
                                               asp-controller="ApplicationTypes"
                                               asp-action="Index"
                                               class="btn btn-outline-primary">
                                                Application Types
                                            </a>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        }
                        else if (isEmployee)
                        {
                            <div class="row g-3 mb-4">

                                <div class="col-md-4">
                                    <div class="home-step-card">
                                        <div class="home-step-number">
                                            1
                                        </div>

                                        <div class="home-step-title">
                                            Open pending cases
                                        </div>

                                        <p class="home-step-text">
                                            Review applications that are ready for evaluation.
                                        </p>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="home-step-card">
                                        <div class="home-step-number">
                                            2
                                        </div>

                                        <div class="home-step-title">
                                            Inspect documents
                                        </div>

                                        <p class="home-step-text">
                                            Compare PDF evidence with submitted field values.
                                        </p>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="home-step-card">
                                        <div class="home-step-number">
                                            3
                                        </div>

                                        <div class="home-step-title">
                                            Use AI assistant
                                        </div>

                                        <p class="home-step-text">
                                            Generate a focused review summary when helpful.
                                        </p>
                                    </div>
                                </div>

                            </div>

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-area="Employee"
                                   asp-controller="Applications"
                                   asp-action="Index"
                                   class="btn btn-primary">
                                    Review Applications
                                </a>

                            </div>
                        }
                        else if (isCitizen)
                        {
                            <div class="row g-3 mb-0">

                                <div class="col-md-4">
                                    <div class="home-admin-action-block h-100">

                                        <div class="home-step-card">
                                            <div class="home-step-number">
                                                1
                                            </div>

                                            <div class="home-step-title">
                                                Start application
                                            </div>

                                            <p class="home-step-text">
                                                Select an available application type and submit your details.
                                            </p>
                                        </div>

                                        <div class="home-admin-action-footer">
                                            <a asp-area="Citizen"
                                               asp-controller="Applications"
                                               asp-action="Index"
                                               class="btn btn-primary">
                                                New Application
                                            </a>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="home-admin-action-block h-100">

                                        <div class="home-step-card">
                                            <div class="home-step-number">
                                                2
                                            </div>

                                            <div class="home-step-title">
                                                Track applications
                                            </div>

                                            <p class="home-step-text">
                                                Follow payments, decisions, timelines and certificates.
                                            </p>
                                        </div>

                                        <div class="home-admin-action-footer">
                                            <a asp-area="Citizen"
                                               asp-controller="Applications"
                                               asp-action="MyApplications"
                                               class="btn btn-outline-primary">
                                                My Applications
                                            </a>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="home-admin-action-block h-100">

                                        <div class="home-step-card">
                                            <div class="home-step-number">
                                                3
                                            </div>

                                            <div class="home-step-title">
                                                View notifications
                                            </div>

                                            <p class="home-step-text">
                                                Read important updates about your submitted applications.
                                            </p>
                                        </div>

                                        <div class="home-admin-action-footer">
                                            <a asp-area="Citizen"
                                               asp-controller="Notifications"
                                               asp-action="Index"
                                               class="btn btn-outline-secondary">
                                                Notifications
                                            </a>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <div class="col-xl-5">

                @await Component.InvokeAsync("DashboardCalendar")

            </div>

        </div>

    </div>
}
else
{
    <div class="auth-simple-page">

        <div class="row align-items-center justify-content-center g-4 auth-simple-row">

            <div class="col-lg-7">
                <div class="card hero-card auth-simple-info-card">
                    <div class="card-body">
                        <h1 class="display-5 auth-simple-title">
                            SATH-Aitisis
                        </h1>

                        <p class="lead text-muted auth-simple-text">
                            A simple electronic submission and tracking system built to improve citizen services.
                        </p>

                        <ul class="list-unstyled mt-3 mb-0 auth-simple-feature-list">
                            <li class="mb-2">
                                <span>•</span>
                                Electronic application submission
                            </li>

                            <li class="mb-2">
                                <span>•</span>
                                PDF supporting documents
                            </li>

                            <li class="mb-2">
                                <span>•</span>
                                Application status tracking
                            </li>

                            <li class="mb-0">
                                <span>•</span>
                                Secure account access
                            </li>
                        </ul>

                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                @await Html.PartialAsync("_LoginForm", new SATH.Aitisis.Web.ViewModels.Account.LoginViewModel())
            </div>

        </div>

        <div class="auth-simple-bottom-bar">

            <span>
                Secure portal access for citizen application services.
            </span>

            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </div>
}