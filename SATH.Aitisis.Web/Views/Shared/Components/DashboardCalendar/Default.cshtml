@model SATH.Aitisis.Web.ViewComponents.DashboardCalendarViewModel

<div class="card shadow-sm dashboard-calendar-card premium-calendar h-100">

    <div class="premium-calendar-header">

        <div>
            <span class="premium-calendar-eyebrow">
                Monthly Overview
            </span>

            <h5 class="premium-calendar-title">
                @Model.MonthName
            </h5>
        </div>

        <div class="premium-calendar-today-pill">
            Today
            <span>
                @Model.TodayText
            </span>
        </div>

    </div>

    <div class="card-body p-4">

        <div class="dashboard-calendar-weekdays premium-calendar-weekdays">
            <div>Mon</div>
            <div>Tue</div>
            <div>Wed</div>
            <div>Thu</div>
            <div>Fri</div>
            <div>Sat</div>
            <div>Sun</div>
        </div>

        <div class="dashboard-calendar-grid premium-calendar-grid">

            @foreach (var day in Model.Days)
            {
                if (day.IsEmpty)
                {
                    <div class="dashboard-calendar-day dashboard-calendar-empty premium-calendar-day premium-calendar-empty">
                    </div>
                }
                else if (day.IsToday)
                {
                    <div class="dashboard-calendar-day dashboard-calendar-today premium-calendar-day premium-calendar-current">
                        <span>
                            @day.DayNumber
                        </span>
                    </div>
                }
                else
                {
                    <div class="dashboard-calendar-day premium-calendar-day">
                        <span>
                            @day.DayNumber
                        </span>
                    </div>
                }
            }

        </div>

        <div class="premium-calendar-note mt-4">

            <div class="premium-calendar-note-icon">
                i
            </div>

            <div>
                <div class="premium-calendar-note-title">
                    Daily workspace
                </div>

                <p class="premium-calendar-note-text">
                    Use this page as your starting point for today’s actions
                    and application-related tasks.
                </p>
            </div>

        </div>

    </div>

</div>