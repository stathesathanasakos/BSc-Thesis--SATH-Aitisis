@model SATH.Aitisis.Web.ViewComponents.DashboardCalendarViewModel

<div class="card shadow-sm dashboard-calendar-card">

    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">
                Calendar
            </h5>

            <small class="text-muted">
                Current month overview
            </small>
        </div>

        <span class="badge bg-primary">
            Today: @Model.TodayText
        </span>
    </div>

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 dashboard-calendar-month">
                @Model.MonthName
            </h6>
        </div>

        <div class="dashboard-calendar-weekdays">
            <div>Mon</div>
            <div>Tue</div>
            <div>Wed</div>
            <div>Thu</div>
            <div>Fri</div>
            <div>Sat</div>
            <div>Sun</div>
        </div>

        <div class="dashboard-calendar-grid">

            @foreach (var day in Model.Days)
            {
                if (day.IsEmpty)
                {
                    <div class="dashboard-calendar-day dashboard-calendar-empty">
                    </div>
                }
                else if (day.IsToday)
                {
                    <div class="dashboard-calendar-day dashboard-calendar-today">
                        <span>
                            @day.DayNumber
                        </span>
                    </div>
                }
                else
                {
                    <div class="dashboard-calendar-day">
                        <span>
                            @day.DayNumber
                        </span>
                    </div>
                }
            }

        </div>

        <div class="alert alert-light border mt-3 mb-0">
            Use this dashboard to monitor your activity and continue working
            with the available system actions.
        </div>

    </div>

</div>