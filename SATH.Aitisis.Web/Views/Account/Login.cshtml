@model SATH.Aitisis.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-simple-page">

    <div class="row align-items-center justify-content-center g-4 auth-simple-row">

        <div class="col-lg-7">
            <div class="card hero-card auth-simple-info-card">
                <div class="card-body">
                    <h1 class="display-5 auth-simple-title">
                        SATH-Aitisis
                    </h1>

                    <p class="lead text-muted auth-simple-text">
                        A simple electronic submission and tracking system built to improve citizen services.
                    </p>

                    <ul class="list-unstyled mt-3 mb-0 auth-simple-feature-list">
                        <li class="mb-2">
                            <span>•</span>
                            Electronic application submission
                        </li>

                        <li class="mb-2">
                            <span>•</span>
                            PDF supporting documents
                        </li>

                        <li class="mb-2">
                            <span>•</span>
                            Application status tracking
                        </li>

                        <li class="mb-0">
                            <span>•</span>
                            Secure account access
                        </li>
                    </ul>

                </div>
            </div>
        </div>

        <div class="col-lg-5">

            <div class="card auth-card auth-start-card">
                <div class="card-body">

                    <div class="auth-card-header mb-3">
                        <span class="auth-card-eyebrow">
                            Account Access
                        </span>

                        <p class="text-muted small mb-0">
                            Secure access for citizens and staff
                        </p>
                    </div>

                    <form asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-2">
                        </div>

                        <input type="hidden"
                               name="returnUrl"
                               value="@ViewData["ReturnUrl"]" />

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control auth-simple-control"
                                   placeholder="email@example.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label">
                            </label>

                            <input asp-for="Password"
                                   class="form-control auth-simple-control"
                                   placeholder="Enter your password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                            </label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit"
                                    class="btn btn-primary">
                                Login
                            </button>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-link auth-simple-link">
                                Register
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>

    </div>

    <div class="auth-simple-bottom-bar">

        <span>
            Secure portal access for citizen application services.
        </span>

        <a asp-controller="Home"
           asp-action="Privacy">
            Privacy
        </a>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}