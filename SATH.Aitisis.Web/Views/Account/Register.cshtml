@model SATH.Aitisis.Web.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-simple-page">

    <div class="row align-items-center justify-content-center g-4 auth-simple-row">

        <div class="col-lg-7">
            <div class="card hero-card auth-simple-info-card">
                <div class="card-body">
                    <h1 class="display-5 auth-simple-title">
                        SATH-Aitisis
                    </h1>

                    <p class="lead text-muted auth-simple-text">
                        Register as a citizen to submit applications and track your application progress.
                    </p>

                    <ul class="list-unstyled mt-3 mb-0 auth-simple-feature-list">
                        <li class="mb-2">
                            <span>•</span>
                            Submit applications through the portal
                        </li>

                        <li class="mb-2">
                            <span>•</span>
                            Upload required PDF documents
                        </li>

                        <li class="mb-2">
                            <span>•</span>
                            Track payments, decisions and certificates
                        </li>

                        <li class="mb-0">
                            <span>•</span>
                            Receive in-app application notifications
                        </li>
                    </ul>

                </div>
            </div>
        </div>

        <div class="col-lg-5">

            <div class="card auth-card auth-start-card">
                <div class="card-body">

                    <div class="auth-card-header mb-3">
                        <span class="auth-card-eyebrow">
                            New Citizen Account
                        </span>

                        <p class="text-muted small mb-0">
                            Create an account to use citizen services.
                        </p>
                    </div>

                    <form asp-action="Register"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-2">
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="FirstName"
                                       class="form-label">
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control auth-simple-control"
                                       placeholder="First name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName"
                                       class="form-label">
                                </label>

                                <input asp-for="LastName"
                                       class="form-control auth-simple-control"
                                       placeholder="Last name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email"
                                       class="form-label">
                                </label>

                                <input asp-for="Email"
                                       class="form-control auth-simple-control"
                                       placeholder="email@example.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password"
                                       class="form-label">
                                </label>

                                <input asp-for="Password"
                                       class="form-control auth-simple-control"
                                       placeholder="Password" />

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword"
                                       class="form-label">
                                </label>

                                <input asp-for="ConfirmPassword"
                                       class="form-control auth-simple-control"
                                       placeholder="Confirm password" />

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <button type="submit"
                                    class="btn btn-primary">
                                Register
                            </button>

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-link auth-simple-link">
                                Back to Login
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>

    </div>

    <div class="auth-simple-bottom-bar">

        <span>
            Citizen accounts are used for secure application submission and tracking.
        </span>

        <a asp-controller="Home"
           asp-action="Privacy">
            Privacy
        </a>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}